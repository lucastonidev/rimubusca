<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
  <style>
    .cguben-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-4);
    }

    .cguben-input {
      font-family: var(--font-mono);
      font-size: 0.9rem;
    }

    .cguben-kv-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
      gap: 10px;
    }

    .cguben-kv {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
    }

    .cguben-kv-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      color: var(--color-text-dim);
      margin-bottom: 3px;
    }

    .cguben-kv-val {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text);
      word-break: break-word;
    }

    .cguben-prog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 12px;
    }

    .cguben-prog-card {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 13px 14px;
    }

    .cguben-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8rem;
    }

    .cguben-table th {
      text-align: left;
      padding: 9px 10px;
      background: var(--color-surface-2);
      color: var(--color-text-muted);
      font-size: 0.7rem;
      text-transform: uppercase;
      border-bottom: 1px solid var(--color-border);
    }

    .cguben-table td {
      padding: 9px 10px;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text);
      vertical-align: top;
    }

    .cguben-filter-chip {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 5px 11px;
      border-radius: var(--radius-sm);
      font-size: 0.75rem;
      cursor: pointer;
    }

    .cguben-filter-chip.active {
      background: rgba(16, 185, 129, 0.16);
      border-color: #10B981;
      color: #34D399;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../partials/sidebar') %>

    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- Cabeçalho -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-5);">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
              <span class="badge badge-purple">CGU Portal da Transparência</span>
              <span class="badge" style="background: rgba(16, 185, 129, 0.14); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.3);">
                Benefícios &amp; Auxílios Sociais
              </span>
            </div>
            <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--color-text); margin: 0;">
              Benefícios &amp; Auxílios Sociais Federais (CGU)
            </h1>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 4px; max-width: 820px;">
              Verificação unificada por CPF ou NIS no Portal da Transparência: Novo Bolsa Família, Auxílio Brasil, Bolsa Família histórico, BPC/LOAS, Auxílio Emergencial, Seguro-Defeso, Garantia-Safra, PETI e flag de Auxílio Reconstrução.
            </p>
          </div>
          <div>
            <a href="/basic/servidores" class="btn btn-outline btn-sm">
              <i data-lucide="landmark" style="width: 14px; height: 14px;"></i>
              Ir para Servidores Federais
            </a>
          </div>
        </div>

        <!-- Formulário -->
        <div class="card" style="margin-bottom: var(--space-5); border-top: 3px solid #10B981;">
          <form id="formAuxilios">
            <div class="cguben-grid" style="margin-bottom: var(--space-4);">
              <div>
                <label for="auxCpf" style="display: block; font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 6px;">
                  CPF do Cidadão (11 dígitos)
                </label>
                <input id="auxCpf" type="text" class="cguben-input" placeholder="Ex: 000.000.000-00" autocomplete="off" />
              </div>

              <div>
                <label for="auxNis" style="display: block; font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 6px;">
                  NIS / PIS / PASEP (Opcional, 11 dígitos)
                </label>
                <input id="auxNis" type="text" class="cguben-input" placeholder="Descoberto automaticamente se houver" autocomplete="off" />
              </div>

              <div>
                <label for="auxPagina" style="display: block; font-size: 0.78rem; font-weight: 600; color: var(--color-text-muted); margin-bottom: 6px;">
                  Página de Parcelas
                </label>
                <input id="auxPagina" type="number" class="cguben-input" min="1" max="20" value="1" />
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: var(--space-3); border-top: 1px solid var(--color-border);">
              <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--color-text); cursor: pointer;">
                <input id="auxVarreduraCompleta" type="checkbox" checked />
                Varredura completa nos 8 programas sociais (além da síntese /pessoa-fisica)
              </label>

              <div style="display: flex; gap: 8px;">
                <button type="button" id="btnLimparAux" class="btn btn-secondary btn-sm">Limpar</button>
                <button type="submit" id="btnConsultarAux" class="btn btn-primary" style="background: linear-gradient(135deg, #059669 0%, #0D9488 100%); border-color: #10B981;">
                  <i data-lucide="search-check" style="width: 16px; height: 16px;"></i>
                  Consultar Benefícios &amp; Auxílios
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Erro -->
        <div id="auxErroBox" style="display: none; margin-bottom: var(--space-5);">
          <div class="card" style="border-color: rgba(239, 68, 68, 0.45); background: var(--color-error-bg);">
            <div style="display: flex; align-items: center; gap: 10px;">
              <i data-lucide="alert-triangle" style="color: var(--color-error); width: 20px; height: 20px;"></i>
              <span id="auxErroMsg" style="color: #FCA5A5; font-size: 0.875rem;"></span>
            </div>
          </div>
        </div>

        <!-- Loading -->
        <div id="auxLoadingBox" style="display: none; margin-bottom: var(--space-5);">
          <div class="card" style="text-align: center; padding: 28px;">
            <div style="color: #34D399; font-weight: 700; margin-bottom: 6px;">Consultando Síntese &amp; Programas Sociais na CGU...</div>
            <div style="font-size: 0.8rem; color: var(--color-text-muted);">Resolvendo NIS vinculado e verificando Bolsa Família, BPC, Auxílio Emergencial, Seguro-Defeso, Safra e PETI.</div>
          </div>
        </div>

        <!-- Resultados -->
        <div id="auxResultados" style="display: none;">
          <!-- Banner -->
          <div class="card" style="margin-bottom: var(--space-5); border-left: 4px solid #10B981;" id="auxBanner">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
              <div>
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px;">
                  <span id="auxStatusBadge" class="badge badge-purple">-</span>
                  <span id="auxSrvAlertBadge" class="badge" style="display: none; background: rgba(239, 68, 68, 0.16); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.4);">
                    Alerta: Também Sinalizado como Servidor Federal
                  </span>
                  <span id="auxCacheBadge" class="badge badge-dark" style="display: none;">Cache 6h</span>
                </div>
                <h2 id="auxResTitulo" style="font-size: 1.25rem; font-weight: 800; color: var(--color-text); margin: 0;">-</h2>
                <div id="auxResSubtitulo" style="font-size: 0.85rem; color: var(--color-text-muted); margin-top: 4px;">-</div>
              </div>

              <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <button type="button" id="btnGerarRelatorioAux" class="btn btn-primary btn-sm" style="background: linear-gradient(135deg, #7C3AED 0%, #4F46E5 100%); border-color: #8B5CF6;">
                  <i data-lucide="file-text" style="width: 14px; height: 14px;"></i>
                  Gerar Relatório Dark
                </button>
                <button type="button" id="btnCopiarJsonAux" class="btn btn-outline btn-sm">
                  <i data-lucide="copy" style="width: 14px; height: 14px;"></i>
                  Copiar JSON
                </button>
              </div>
            </div>

            <div class="cguben-kv-grid" id="auxKpiGrid" style="margin-top: var(--space-4);"></div>

            <div id="auxPivotWrap" style="display: none; margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--color-border); flex-wrap: wrap; gap: 8px; align-items: center;">
              <span style="font-size: 0.75rem; color: var(--color-text-dim);">Pivô OSINT:</span>
              <div id="auxPivotBtns" style="display: flex; flex-wrap: wrap; gap: 8px;"></div>
            </div>
          </div>

          <!-- Flags /pessoa-fisica -->
          <div id="auxFlagsCard" class="card" style="display: none; margin-bottom: var(--space-5);">
            <div class="card-header">
              <div class="card-title">
                <i data-lucide="shield-check" style="color: #A78BFA;"></i>
                <span>Sinalizadores Oficiais /pessoa-fisica (CGU)</span>
              </div>
              <span id="auxNisResolvidoBadge" class="badge badge-dark">-</span>
            </div>
            <div class="card-body" id="auxFlagsBody"></div>
          </div>

          <!-- Matriz dos 8 Programas -->
          <div class="card" style="margin-bottom: var(--space-5);">
            <div class="card-header">
              <div class="card-title">
                <i data-lucide="layers" style="color: #38BDF8;"></i>
                <span>Matriz de Programas Sociais Consultados</span>
              </div>
              <span id="auxMatrizBadge" class="badge badge-dark">-</span>
            </div>
            <div class="card-body">
              <div class="cguben-prog-grid" id="auxProgramasGrid"></div>
            </div>
          </div>

          <!-- Tabela Consolidada de Parcelas -->
          <div class="card" style="margin-bottom: var(--space-5);">
            <div class="card-header" style="flex-wrap: wrap; gap: 10px;">
              <div class="card-title">
                <i data-lucide="receipt" style="color: #34D399;"></i>
                <span>Detalhamento de Parcelas &amp; Pagamentos</span>
              </div>
              <div id="auxFiltroProgramas" style="display: flex; flex-wrap: wrap; gap: 6px;"></div>
            </div>
            <div class="card-body" style="overflow-x: auto;" id="auxParcelasTableWrap"></div>
          </div>
        </div>
      </main>

      <%- include('../../partials/footer') %>
    </div>
  </div>

  <!-- Modal Relatório Dark -->
  <div id="modalRelatorioAuxilios" class="modal-relatorio-backdrop" role="dialog" aria-modal="true">
    <div class="modal-relatorio-dialog">
      <div class="modal-relatorio-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, #059669 0%, #4F46E5 100%); display: flex; align-items: center; justify-content: center; color: #FFFFFF;">
            <i data-lucide="hand-coins" style="width: 18px; height: 18px;"></i>
          </div>
          <div>
            <h2 style="font-size: 1.05rem; font-weight: 700; color: #FFFFFF; margin: 0;">
              Dossiê CGU • Benefícios &amp; Auxílios Sociais
            </h2>
            <p style="font-size: 0.75rem; color: #94A3B8; margin: 2px 0 0;">
              Relatório estruturado em Dark Mode pronto para exportação em PDF ou HTML.
            </p>
          </div>
        </div>
        <div style="display: flex; gap: 8px;">
          <button type="button" id="btnPdfAux" class="btn btn-primary btn-sm">Exportar PDF</button>
          <button type="button" id="btnHtmlAux" class="btn btn-outline btn-sm" style="border-color: rgba(16, 185, 129, 0.4); color: #34D399;">Baixar HTML</button>
          <button type="button" id="btnFecharModalAux" class="btn btn-ghost btn-sm" style="color: #94A3B8;">
            <i data-lucide="x" style="width: 18px; height: 18px;"></i>
          </button>
        </div>
      </div>
      <div id="modalRelatorioAuxiliosBody" class="modal-relatorio-body"></div>
    </div>
  </div>

  <%- include('../../partials/bottom-nav') %>
  <%- include('../../partials/command-palette') %>
  <%- include('../../partials/toast') %>

  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/osint-dark-report.js"></script>
  <script src="/js/auxilios.js"></script>
</body>
</html>
