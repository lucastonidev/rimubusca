<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>

  <style>
    .email-search-card {
      background: radial-gradient(circle at 95% 5%, rgba(139, 92, 246, 0.08) 0%, transparent 60%),
                  var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      margin-bottom: var(--space-6);
      box-shadow: var(--shadow-sm);
    }

    .email-input-group {
      display: flex;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .email-main-input {
      flex: 1;
      padding: 10px 16px;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 1rem;
      font-family: var(--font-mono);
      outline: none;
      transition: all var(--transition-fast);
    }

    .email-main-input:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px var(--color-primary-glow);
      background-color: var(--color-surface);
    }

    .demo-pills-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .demo-email-btn {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-family: var(--font-mono);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
    }

    .demo-email-btn:hover {
      background: var(--color-surface-3);
      color: var(--color-primary);
      border-color: var(--color-primary-glow);
    }

    .email-results-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-5);
      margin-bottom: var(--space-6);
    }

    /* Holehe Platform Grid */
    .holehe-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: var(--space-3);
    }

    .holehe-item {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 8px;
      transition: all var(--transition-fast);
    }

    .holehe-item.registered {
      border-color: rgba(34, 197, 94, 0.4);
      background: rgba(34, 197, 94, 0.04);
    }

    .holehe-item.registered:hover {
      border-color: var(--color-success);
      transform: translateY(-2px);
    }

    .holehe-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .holehe-name {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--color-text);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* GHunt Styles */
    .ghunt-card {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-5);
    }

    .ghunt-services-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-4);
    }

    .ghunt-service-pill {
      background: var(--color-surface-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }

    .dorks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-3);
    }

    .dork-item {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .dork-title {
      font-size: 0.825rem;
      font-weight: 600;
      color: var(--color-text);
      margin-bottom: 4px;
    }

    .dork-query {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--color-text-dim);
      background: var(--color-surface-3);
      padding: 6px 8px;
      border-radius: var(--radius-sm);
      word-break: break-all;
      margin-bottom: var(--space-3);
    }

    .dork-actions {
      display: flex;
      gap: var(--space-2);
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../partials/sidebar') %>

    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- Topo do Módulo -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-4);">
          <div>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="badge badge-purple">Módulo OSINT Integrado</span>
              <span class="badge badge-dark">DNS • Diablinda • Rimuhunt</span>
            </div>
            <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text); margin-top: 6px; display: flex; align-items: center; gap: 10px;">
              <i data-lucide="mail-search" style="color: var(--color-secondary); width: 28px; height: 28px;"></i>
              <span>Investigação Avançada de E-mail</span>
            </h1>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 4px;">
              Reconhecimento técnico com motores 100% nativos: Diablinda (55+ plataformas com metadados), Rimuhunt (Google Gaia ID & Avatar HD) e infraestrutura DNS.
            </p>
          </div>
        </div>

        <!-- Formulário de Consulta -->
        <section class="email-search-card">
          <form id="formInvestigarEmail">
            <label for="inputEmail" style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--color-text);">
              Endereço de E-mail para Investigação
            </label>
            <div class="email-input-group">
              <input
                type="email"
                id="inputEmail"
                class="email-main-input"
                placeholder="exemplo@gmail.com ou alvo@empresa.com.br"
                autocomplete="off"
                required
              />
              <button type="submit" class="btn btn-primary" id="btnSubmitEmail">
                <i data-lucide="search" style="width: 16px; height: 16px;"></i>
                Investigar
              </button>
            </div>

            <div class="demo-pills-row">
              <span style="font-size: 0.75rem; color: var(--color-text-dim);">Exemplos para Teste:</span>
              <button type="button" class="demo-email-btn" data-email="carlos.silva.pereira@gmail.com">
                <i data-lucide="mail"></i> carlos.silva.pereira@gmail.com
              </button>
              <button type="button" class="demo-email-btn" data-email="contato@google.com">
                <i data-lucide="globe"></i> contato@google.com
              </button>
              <button type="button" class="demo-email-btn" data-email="admin@rimubusca.org">
                <i data-lucide="shield"></i> admin@rimubusca.org
              </button>
              <button type="button" class="demo-email-btn" data-email="teste@temp-mail.org">
                <i data-lucide="trash-2"></i> teste@temp-mail.org
              </button>
            </div>
          </form>
        </section>

        <!-- Skeleton de Carregamento -->
        <div id="emailSkeleton" style="display: none;">
          <div class="card" style="padding: var(--space-6); text-align: center;">
            <div class="spinner" style="margin: 0 auto var(--space-4);"></div>
            <p style="font-size: 0.95rem; color: var(--color-text); font-weight: 600;">Executando Reconhecimento OSINT (DNS, Diablinda & Rimuhunt)...</p>
            <p style="font-size: 0.8rem; color: var(--color-text-dim);">Varrendo 55+ plataformas com Diablinda, extraindo metadados Google com Rimuhunt e validando zonas MX.</p>
          </div>
        </div>

        <!-- Seção de Resultados (Oculta Inicialmente) -->
        <div id="emailResultados" style="display: none;">
          <!-- Top Bar do Resultado -->
          <div class="card" style="padding: var(--space-5); margin-bottom: var(--space-5); background: var(--color-surface);">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
              <div style="display: flex; align-items: center; gap: var(--space-4);">
                <div id="resAvatarContainer" style="width: 52px; height: 52px; border-radius: var(--radius-full); background: var(--color-surface-3); display: flex; align-items: center; justify-content: center; overflow: hidden; border: 2px solid var(--color-border);">
                  <i data-lucide="user" style="width: 26px; height: 26px; color: var(--color-primary);"></i>
                </div>
                <div>
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <h2 id="resEmailTitulo" style="font-size: 1.25rem; font-weight: 700; color: var(--color-text); margin: 0; font-family: var(--font-mono);">
                      -
                    </h2>
                    <span id="resBadgeClassificacao" class="badge badge-purple">-</span>
                  </div>
                  <div style="display: flex; gap: var(--space-3); margin-top: 4px; font-size: 0.8rem; color: var(--color-text-dim);">
                    <span>Usuário: <strong id="resUsuario" style="color: var(--color-text);">-</strong></span>
                    <span>Domínio: <strong id="resDominio" style="color: var(--color-text);">-</strong></span>
                  </div>
                </div>
              </div>

              <!-- Provedor Detectado -->
              <div style="text-align: right;">
                <div style="font-size: 0.75rem; color: var(--color-text-dim);">Provedor de Correio</div>
                <div id="resProvedorDetectado" style="font-size: 0.95rem; font-weight: 600; color: var(--color-text);">-</div>
              </div>
            </div>
          </div>

          <!-- MOTOR 1: DIABLINDA (Cross-Platform Accounts & Metadata) -->
          <div class="card" style="margin-bottom: var(--space-5);">
            <div class="card-header">
              <div class="card-title">
                <i data-lucide="network" style="color: var(--color-primary);"></i>
                <span>Diablinda • Contas Registradas em Redes Sociais & Serviços (55+ Plataformas)</span>
              </div>
              <span id="resTotalHoleheBadge" class="badge badge-purple">0 Plataformas</span>
            </div>
            <div class="card-body">
              <p style="font-size: 0.8rem; color: var(--color-text-muted); margin-bottom: var(--space-4);">
                Identificação de contas vinculadas ao e-mail através de endpoints de registro e recuperação sem alertar o usuário, com suporte a SVG e metadados.
              </p>
              <div class="holehe-grid" id="resHoleheContainer">
                <!-- Injetado dinamicamente via email.js -->
              </div>
            </div>
          </div>

          <!-- MOTOR 2: RIMUHUNT (Google OSINT) -->
          <div class="card" style="margin-bottom: var(--space-5);">
            <div class="card-header">
              <div class="card-title">
                <i data-lucide="layers" style="color: #F59E0B;"></i>
                <span>Rimuhunt • Inteligência de Contas Google (Gaia ID & Avatar HD)</span>
              </div>
              <span id="resGHuntStatusBadge" class="badge badge-dark">Google Recon</span>
            </div>
            <div class="card-body" id="resGHuntContainer">
              <!-- Injetado dinamicamente via email.js -->
            </div>
          </div>

          <!-- MOTOR 3: MOSINT (Técnica & DNS) -->
          <div class="email-results-grid">
            <!-- Card: DNS & Entregabilidade (Mosint) -->
            <div class="card">
              <div class="card-header">
                <div class="card-title">
                  <i data-lucide="server" style="color: var(--color-primary);"></i>
                  <span>Mosint • DNS & Entregabilidade</span>
                </div>
                <span id="resMxStatusBadge" class="badge badge-purple">MX Ativo</span>
              </div>
              <div class="card-body">
                <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                  <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 6px;">
                    <span style="font-size: 0.8rem; color: var(--color-text-muted);">Servidor MX (Mail Exchange)</span>
                    <span id="resMxStatus" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text);">-</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 6px;">
                    <span style="font-size: 0.8rem; color: var(--color-text-muted);">Registro SPF (Anti-Spoofing)</span>
                    <span id="resSpfStatus" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text);">-</span>
                  </div>
                  <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--color-border); padding-bottom: 6px;">
                    <span style="font-size: 0.8rem; color: var(--color-text-muted);">DMARC Policy</span>
                    <span id="resDmarcStatus" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text);">-</span>
                  </div>

                  <div style="margin-top: var(--space-2);">
                    <span style="font-size: 0.75rem; color: var(--color-text-dim); display: block; margin-bottom: 4px;">Hosts MX Detectados:</span>
                    <div id="resMxHostsList" style="font-family: var(--font-mono); font-size: 0.75rem; background: var(--color-surface-2); padding: 8px; border-radius: var(--radius-sm); max-height: 90px; overflow-y: auto;">
                      -
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card: Hashes Criptográficos & Identidade -->
            <div class="card">
              <div class="card-header">
                <div class="card-title">
                  <i data-lucide="fingerprint" style="color: var(--color-secondary);"></i>
                  <span>Hashes Forenses & Identidade</span>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" id="btnCopiarHashes">
                  <i data-lucide="copy" style="width: 13px; height: 13px;"></i>
                  Copiar
                </button>
              </div>
              <div class="card-body">
                <div style="display: flex; flex-direction: column; gap: var(--space-3);">
                  <div>
                    <span style="font-size: 0.75rem; color: var(--color-text-dim);">MD5 Hash (Gravatar / Recon)</span>
                    <div id="resHashMd5" style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-primary); background: var(--color-surface-2); padding: 6px 8px; border-radius: var(--radius-sm); word-break: break-all; margin-top: 2px;">
                      -
                    </div>
                  </div>

                  <div>
                    <span style="font-size: 0.75rem; color: var(--color-text-dim);">SHA-256 Hash</span>
                    <div id="resHashSha256" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-text); background: var(--color-surface-2); padding: 6px 8px; border-radius: var(--radius-sm); word-break: break-all; margin-top: 2px;">
                      -
                    </div>
                  </div>

                  <div style="display: flex; gap: var(--space-2); margin-top: var(--space-2);">
                    <a id="linkGoogleProfile" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="flex: 1; justify-content: center; font-size: 0.75rem;">
                      <i data-lucide="external-link" style="width: 12px; height: 12px;"></i>
                      Google Contacts
                    </a>
                    <a id="linkGithubProfile" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="flex: 1; justify-content: center; font-size: 0.75rem;">
                      <i data-lucide="github" style="width: 12px; height: 12px;"></i>
                      GitHub Search
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Card de Google Dorks OSINT (Padrão: Oculto) -->
          <div class="card" style="margin-bottom: var(--space-6); display: none;">
            <div class="card-header">
              <div class="card-title">
                <i data-lucide="terminal" style="color: var(--color-primary);"></i>
                <span>Google Dorks de Reconhecimento</span>
              </div>
              <span class="badge badge-purple">5 Consultas</span>
            </div>
            <div class="card-body">
              <div class="dorks-grid" id="resDorksContainer">
                <!-- Preenchido via JS -->
              </div>
            </div>
          </div>

          <!-- Botões de Ação Final -->
          <div style="display: flex; justify-content: flex-end; gap: var(--space-3); margin-top: var(--space-4);">
            <button type="button" class="btn btn-secondary" id="btnVerJsonCompleto">
              <i data-lucide="code" style="width: 16px; height: 16px;"></i>
              Ver JSON Bruto
            </button>
            <button type="button" class="btn btn-primary" onclick="window.scrollTo({ top: 0, behavior: 'smooth' }); document.getElementById('inputEmail').focus();">
              <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
              Nova Investigação
            </button>
          </div>
        </div>
      </main>

      <%- include('../../partials/footer') %>
    </div>
  </div>

  <%- include('../../partials/bottom-nav') %>
  <%- include('../../partials/command-palette') %>
  <%- include('../../partials/toast') %>

  <!-- Modal Raw JSON -->
  <div id="modalJson" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: var(--z-modal); align-items: center; justify-content: center; padding: var(--space-4);">
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); width: 100%; max-width: 700px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden;">
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 700; color: var(--color-text);">Payload JSON da Investigação de E-mail</span>
        <button type="button" onclick="document.getElementById('modalJson').style.display='none'" style="background: none; border: none; color: var(--color-text-muted); cursor: pointer;">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>
      <pre id="preModalJson" style="padding: var(--space-4); margin: 0; overflow-y: auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim); background: var(--color-surface-2); flex: 1;"></pre>
      <div style="padding: var(--space-3); border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end; gap: var(--space-2);">
        <button type="button" class="btn btn-secondary btn-sm" id="btnCopiarJsonModal">Copiar JSON</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('modalJson').style.display='none'">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/email.js"></script>
</body>
</html>
