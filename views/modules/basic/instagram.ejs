            <!-- Correspondências de Palavras-Chave -->
            <div id="bdKeywordsHitsBox" class="card" style="display: none; padding: var(--space-4); margin-bottom: var(--space-4); border-color: rgba(245, 158, 11, 0.35);"></div>

            <!-- Grid Inteligência OSINT -->
            <div id="bdInteligenciaGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4);"></div>

            <!-- Barra de Filtro Local Instantâneo + Botão Dossiê Dark -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4);">
              <div style="flex: 1; min-width: 220px;">
                <input
                  type="text"
                  id="bdLocalKeywordFilter"
                  class="redes-input-field"
                  placeholder="Filtrar instantaneamente nos posts e comentários coletados (0 créditos extras)..."
                  style="padding: 8px 12px; font-size: 0.82rem;"
                />
              </div>
              <button type="button" id="btnBdAbrirDossie" class="btn btn-primary">
                <i data-lucide="file-text" style="width: 16px; height: 16px;"></i>
                Gerar Dossiê OSINT (Dark PDF / HTML)
              </button>
            </div>

            <!-- Feed de Posts e Comentários -->
            <div id="bdPostsContainer"></div>
          </div>
        </section>
      </main>

      <%- include('../../partials/footer') %>
    </div>
  </div>

  <%- include('../../partials/bottom-nav') %>
  <%- include('../../partials/command-palette') %>
  <%- include('../../partials/toast') %>

  <!-- Modal Raw JSON -->
  <div id="modalJson" style="display: none; position: fixed; inset: 0; background: rgba(4, 7, 13, 0.85); backdrop-filter: blur(6px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); width: 100%; max-width: 700px; max-height: calc(100vh - 40px); display: flex; flex-direction: column; overflow: hidden;">
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
        <span style="font-weight: 700; color: var(--color-text);">Payload JSON YesItsMe</span>
        <button type="button" onclick="document.getElementById('modalJson').style.display='none'" style="background: none; border: none; color: var(--color-text-muted); cursor: pointer;">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>
      <pre id="preModalJson" style="padding: var(--space-4); margin: 0; overflow-y: auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim); background: var(--color-surface-2); flex: 1;"></pre>
      <div style="padding: var(--space-3); border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end; gap: var(--space-2); flex-shrink: 0;">
        <button type="button" class="btn btn-secondary btn-sm" id="btnCopiarJsonModal">Copiar JSON</button>
        <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('modalJson').style.display='none'">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Modal Avatar HD & Busca Reversa -->
  <div id="modalAvatarHd" style="display: none; position: fixed; inset: 0; background: rgba(4, 7, 13, 0.88); backdrop-filter: blur(6px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); width: 100%; max-width: 520px; max-height: calc(100vh - 40px); display: flex; flex-direction: column; overflow: hidden; box-shadow: var(--shadow-xl);">
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <i data-lucide="image" style="color: var(--color-primary); width: 20px; height: 20px;"></i>
          <span style="font-weight: 700; color: var(--color-text); font-size: 0.95rem;">Foto de Perfil HD & Investigação Visual</span>
        </div>
        <button type="button" class="btn-fechar-modal-avatar" style="background: none; border: none; color: var(--color-text-muted); cursor: pointer; padding: 4px;">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>

      <div style="padding: var(--space-5); text-align: center; background: radial-gradient(circle at center, rgba(139, 92, 246, 0.08) 0%, var(--color-surface-2) 100%);">
        <div style="width: 220px; height: 220px; margin: 0 auto; border-radius: var(--radius-full); overflow: hidden; border: 3px solid var(--color-border); box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5); background: var(--color-surface-3);">
          <img id="imgAvatarModal" src="" alt="Avatar HD" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div id="txtAvatarUser" style="margin-top: var(--space-3); font-weight: 700; font-family: var(--font-mono); color: var(--color-primary); font-size: 1.05rem;">@username</div>
      </div>

      <div style="padding: var(--space-4); background: var(--color-surface); border-top: 1px solid var(--color-border);">
        <div style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-2); display: flex; align-items: center; gap: 6px;">
          <i data-lucide="scan-face" style="width: 13px; height: 13px; color: var(--color-primary);"></i>
          Busca Reversa de Imagem em 1 Clique:
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);">
          <a id="btnLensModal" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="justify-content: center; gap: 6px;">
            <i data-lucide="search" style="width: 14px; height: 14px; color: #4285F4;"></i>
            Google Lens
          </a>
          <a id="btnYandexModal" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="justify-content: center; gap: 6px;">
            <i data-lucide="external-link" style="width: 14px; height: 14px; color: #fc3f1d;"></i>
            Yandex Images
          </a>
          <a id="btnBingModal" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="justify-content: center; gap: 6px;">
            <i data-lucide="external-link" style="width: 14px; height: 14px; color: #008373;"></i>
            Bing Visual
          </a>
          <a id="btnTinEyeModal" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="justify-content: center; gap: 6px;">
            <i data-lucide="crosshair" style="width: 14px; height: 14px; color: var(--color-primary);"></i>
            TinEye
          </a>
        </div>
      </div>

      <div style="padding: var(--space-3) var(--space-4); border-top: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center; background: var(--color-surface-2);">
        <button type="button" class="btn btn-secondary btn-sm" id="btnCopiarUrlFoto">
          <i data-lucide="copy" style="width: 13px; height: 13px;"></i>
          Copiar URL Imagem
        </button>
        <button type="button" class="btn btn-primary btn-sm btn-fechar-modal-avatar">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Modal Dossiê Social OSINT (Dark Mode / PDF / HTML + Imagens) -->
  <div id="modalBdDossie" role="dialog" aria-modal="true" aria-label="Dossiê Social OSINT" style="display: none; position: fixed; inset: 0; background: rgba(4, 7, 13, 0.88); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div id="modalBdDossieDialog" style="background: #080B11; border: 1px solid rgba(139, 92, 246, 0.35); border-radius: var(--radius-lg); width: 100%; max-width: 1040px; max-height: calc(100vh - 40px); display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.9), 0 0 30px rgba(139, 92, 246, 0.15);">
      <div style="padding: 14px 20px; border-bottom: 1px solid rgba(139, 92, 246, 0.22); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; background: #0D111A; flex-shrink: 0;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 30px; height: 30px; border-radius: 8px; background: linear-gradient(135deg, #7C3AED 0%, #4F46E5 100%); display: flex; align-items: center; justify-content: center; color: #FFFFFF;">
            <i data-lucide="file-text" style="width: 16px; height: 16px;"></i>
          </div>
          <div>
            <div style="font-weight: 700; color: #F8FAFC; font-size: 0.95rem;">Dossiê Social OSINT (Bright Data)</div>
            <div style="font-size: 0.72rem; color: #94A3B8;">Prévia Dark Mode pronta para Exportar PDF ou Baixar HTML</div>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
          <button type="button" id="btnBdAddImagem" class="btn btn-secondary btn-sm">
            <i data-lucide="image-plus" style="width: 14px; height: 14px;"></i>
            Adicionar Imagem / Print
          </button>
          <input type="file" id="bdInputCustomImages" accept="image/*" multiple style="display: none;" />
          <button type="button" id="btnBdExportPdf" class="btn btn-primary btn-sm">
            <i data-lucide="printer" style="width: 14px; height: 14px;"></i>
            Exportar PDF
          </button>
          <button type="button" id="btnBdDownloadHtml" class="btn btn-secondary btn-sm">
            <i data-lucide="download" style="width: 14px; height: 14px;"></i>
            Baixar HTML
          </button>
          <button type="button" class="btn-fechar-bd-dossie" aria-label="Fechar modal" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(148,163,184,0.2); border-radius: 6px; color: #CBD5E1; cursor: pointer; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
            <i data-lucide="x" style="width: 16px; height: 16px;"></i>
          </button>
        </div>
      </div>

      <!-- Barra de Evidências Visuais Anexadas + Toggle Fotos dos Posts -->
      <div style="padding: 10px 20px; background: #0B0F18; border-bottom: 1px solid #1E2538; flex-shrink: 0; display: flex; flex-direction: column; gap: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; font-size: 0.76rem;">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <label style="display: inline-flex; align-items: center; gap: 6px; color: #CBD5E1; cursor: pointer;">
              <input type="checkbox" id="bdCheckIncluirFotosPosts" checked style="accent-color: #8B5CF6; width: 14px; height: 14px;" />
              <span>Exibir fotos coletadas dos posts</span>
            </label>
            <span id="bdCustomImagesCount" class="badge badge-dark" style="font-size: 0.7rem;">0 prints/imagens anexadas</span>
          </div>
          <span style="color: #64748B; font-size: 0.72rem;">Dica: você também pode colar um print direto com <strong>Ctrl+V</strong></span>
        </div>
        <div id="bdCustomImagesPreview" style="display: none; flex-wrap: wrap; gap: 10px; max-height: 112px; overflow-y: auto; padding-top: 2px;"></div>
      </div>

      <div id="modalBdDossieBody" style="padding: 20px; overflow-y: auto; flex: 1; background: #040609;"></div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/osint-dark-report.js"></script>
  <script src="/js/redes.js"></script>
  <script src="/js/redes-brightdata.js"></script>
</body>
</html>

