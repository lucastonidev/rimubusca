<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>

  <style>
    .redes-search-card {
      background: radial-gradient(circle at 95% 5%, rgba(139, 92, 246, 0.08) 0%, transparent 60%),
                  var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      margin-bottom: var(--space-6);
      box-shadow: var(--shadow-sm);
    }

    .redes-input-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    .redes-input-field {
      width: 100%;
      padding: 10px 14px;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 0.9rem;
      outline: none;
      transition: all var(--transition-fast);
    }

    .redes-input-field:focus {
      border-color: var(--color-primary);
      box-shadow: 0 0 0 3px var(--color-primary-glow);
      background-color: var(--color-surface);
    }

    .demo-pills-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .demo-redes-btn {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
    }

    .demo-redes-btn:hover {
      background: var(--color-surface-3);
      color: var(--color-primary);
      border-color: rgba(139, 92, 246, 0.4);
    }

    .profile-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      margin-bottom: var(--space-4);
      display: flex;
      gap: var(--space-4);
      align-items: flex-start;
      transition: all var(--transition-fast);
    }

    .profile-card:hover {
      border-color: var(--color-primary);
      box-shadow: var(--shadow-sm);
    }

    .profile-avatar-box {
      width: 64px;
      height: 64px;
      border-radius: var(--radius-full);
      background: var(--color-surface-3);
      overflow: hidden;
      flex-shrink: 0;
      border: 2px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .match-pill-high {
      background: rgba(239, 68, 68, 0.15);
      color: var(--color-secondary);
      border: 1px solid rgba(239, 68, 68, 0.35);
      font-weight: 700;
    }

    .match-pill-medium {
      background: rgba(139, 92, 246, 0.15);
      color: var(--color-primary);
      border: 1px solid rgba(139, 92, 246, 0.35);
      font-weight: 700;
    }

    .match-pill-low {
      background: var(--color-surface-3);
      color: var(--color-text-dim);
      border: 1px solid var(--color-border);
    }

    .dorks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--space-3);
    }

    .dork-item {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .dork-item:hover {
      border-color: var(--color-primary-glow);
    }

    /* Estilos Avançados de Probabilidade e Máscaras YesItsMe */
    .prob-bar-track {
      width: 100%;
      height: 8px;
      background: var(--color-surface-3);
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-top: 6px;
    }

    .prob-bar-fill {
      height: 100%;
      border-radius: var(--radius-full);
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .factors-checklist {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: var(--space-2);
      margin-top: var(--space-3);
    }

    .factor-item {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 8px 12px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.78rem;
    }

    .factor-item.factor-match {
      border-color: rgba(34, 197, 94, 0.35);
      background: rgba(34, 197, 94, 0.05);
    }

    .factor-item.factor-mismatch {
      border-color: rgba(239, 68, 68, 0.25);
      background: rgba(239, 68, 68, 0.03);
    }

    .mask-summary-box {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: var(--space-3) var(--space-4);
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      align-items: center;
      margin-bottom: var(--space-4);
    }

    /* Avatar interativo com badge HD */
    .profile-avatar-wrapper {
      position: relative;
      display: inline-block;
      cursor: pointer;
    }

    .profile-avatar-wrapper:hover .avatar-hd-badge {
      opacity: 1;
      transform: scale(1.05);
    }

    .avatar-hd-badge {
      position: absolute;
      bottom: -4px;
      right: -4px;
      background: var(--color-primary);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 800;
      padding: 2px 5px;
      border-radius: var(--radius-full);
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      display: flex;
      align-items: center;
      gap: 3px;
      transition: all var(--transition-fast);
      pointer-events: none;
    }

    /* Badge de Idade da Conta via ID Numérico */
    .account-age-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: var(--radius-full);
      font-size: 0.72rem;
      font-weight: 600;
      border: 1px solid var(--color-border);
      background: var(--color-surface-2);
      transition: all var(--transition-fast);
    }

    .account-age-badge:hover {
      border-color: var(--color-primary);
      background: var(--color-surface-3);
    }

    /* Entidades da Bio (WhatsApp, E-mail, Pix, Links) */
    .bio-entities-container {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin: 8px 0;
    }

    .entity-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: var(--radius-sm);
      font-size: 0.72rem;
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .entity-pill-whatsapp {
      background: rgba(34, 197, 94, 0.12);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.3);
      font-weight: 600;
    }

    .entity-pill-whatsapp:hover {
      background: rgba(34, 197, 94, 0.22);
      color: #4ade80;
    }

    .entity-pill-email {
      background: rgba(139, 92, 246, 0.12);
      color: var(--color-primary);
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .entity-pill-email:hover {
      background: rgba(139, 92, 246, 0.22);
    }

    .entity-pill-pix {
      background: rgba(245, 158, 11, 0.12);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.3);
      font-family: var(--font-mono);
    }

    .entity-pill-link {
      background: rgba(59, 130, 246, 0.12);
      color: #3b82f6;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .entity-pill-link:hover {
      background: rgba(59, 130, 246, 0.22);
    }

    .entity-pill-mention {
      background: var(--color-surface-3);
      color: var(--color-text);
      border: 1px solid var(--color-border);
      font-family: var(--font-mono);
    }

    .entity-pill-mention:hover {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    /* Toolbar de Pivotamento Social Cross-Platform */
    .pivot-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      margin-top: 10px;
    }

    .pivot-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: var(--radius-xs);
      font-size: 0.72rem;
      color: var(--color-text-dim);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .pivot-btn:hover {
      color: var(--color-text);
      border-color: var(--color-primary);
      background: var(--color-surface-3);
    }

    .reverse-search-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 7px;
      font-size: 0.68rem;
      border-radius: var(--radius-xs);
      background: var(--color-surface-2);
      color: var(--color-text-dim);
      border: 1px solid var(--color-border);
      text-decoration: none;
      transition: all var(--transition-fast);
    }

    .reverse-search-btn:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }

    /* Layout alinhado para Coleta Social Profunda (Bright Data) */
    .bd-form-grid-top {
      display: grid;
      grid-template-columns: minmax(150px, 0.9fr) minmax(200px, 1.2fr) minmax(240px, 1.6fr);
      gap: var(--space-3);
      align-items: end;
    }

    .bd-form-grid-kw {
      margin-top: var(--space-3);
      display: grid;
      grid-template-columns: 1fr;
    }

    .bd-field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 0;
    }

    .bd-field-label {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-dim);
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .bd-field-control {
      height: 42px;
      box-sizing: border-box;
      padding: 0 12px;
      line-height: 40px;
    }

    .bd-form-controls-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: var(--space-3);
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .bd-toggle-pill {
      height: 42px;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0 14px;
      border-radius: var(--radius-md);
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      font-size: 0.8rem;
      color: var(--color-text);
      cursor: pointer;
      user-select: none;
      transition: border-color var(--transition-fast);
    }

    .bd-toggle-pill:hover {
      border-color: rgba(139, 92, 246, 0.45);
    }

    @media (max-width: 820px) {
      .bd-form-grid-top {
        grid-template-columns: 1fr;
      }
      .bd-field-label {
        white-space: normal;
      }
      .profile-card {
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../../partials/sidebar') %>

    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- Topo Repaginado e Explicativo -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-4);">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
              <span class="badge badge-purple" style="display: inline-flex; align-items: center; gap: 5px;">
                <i data-lucide="globe" style="width: 12px; height: 12px;"></i>
                Multiplataforma • 80+ Redes
              </span>
              <span class="badge badge-blue" style="display: inline-flex; align-items: center; gap: 5px;">
                <i data-lucide="scan-face" style="width: 12px; height: 12px;"></i>
                Cruzamento Cadastral de Perfis
              </span>
              <span class="badge badge-dark">OSINT Social</span>
            </div>
            <h1 style="font-size: 1.55rem; font-weight: 800; color: var(--color-text); margin: 0; letter-spacing: -0.02em;">
              Redes Sociais &amp; Contas Online
            </h1>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 4px; max-width: 820px; line-height: 1.45;">
              Rastreie a pegada digital do alvo: pesquise por <strong>@Username</strong> em dezenas de redes simultaneamente ou descubra perfis desconhecidos cruzando <strong>Nome, E-mail e Telefone</strong> com pistas reais de recuperação de conta.
            </p>
          </div>

          <a href="/dashboard" class="btn btn-secondary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
            <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
            Voltar ao Dashboard
          </a>
        </div>

        <!-- Card Explicativo: Como Funciona o Módulo -->
        <section class="card" style="background: linear-gradient(135deg, rgba(13, 17, 26, 0.9) 0%, rgba(20, 16, 36, 0.9) 100%); border: 1px solid rgba(139, 92, 246, 0.25); padding: var(--space-4); margin-bottom: var(--space-5); border-radius: var(--radius-lg);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <i data-lucide="help-circle" style="width: 18px; height: 18px; color: var(--color-primary);"></i>
              <span style="font-weight: 700; font-size: 0.88rem; color: #F8FAFC;">Como funciona esta investigação?</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--color-text-dim);">3 Formas de Localização</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; font-size: 0.78rem;">
            <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-weight: 700; color: #C4B5FD; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="at-sign" style="width: 14px; height: 14px; color: var(--color-primary);"></i>
                1. Varredura por @Username
              </div>
              <p style="margin: 0; color: #94A3B8; line-height: 1.4;">
                Se você já tem o apelido ou @ da pessoa, o sistema varre ativamente se ela possui conta criada em <strong>80+ redes sociais</strong> (Instagram, TikTok, Twitter/X, GitHub, Reddit, Spotify, Steam, etc.).
              </p>
            </div>

            <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-weight: 700; color: #38BDF8; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="user-check" style="width: 14px; height: 14px; color: #38BDF8;"></i>
                2. Descoberta por Nome/E-mail/Telefone
              </div>
              <p style="margin: 0; color: #94A3B8; line-height: 1.4;">
                Quando você não sabe o @, o motor gera variações com preposições em português (da/de/do) e compara com os caracteres ofuscados de recuperação de conta (ex: <code>c*****o@g*****.com</code> e final <code>**-4321</code>).
              </p>
            </div>

            <div style="background: rgba(0, 0, 0, 0.35); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: var(--radius-md); padding: 12px;">
              <div style="font-weight: 700; color: #34D399; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                <i data-lucide="radar" style="width: 14px; height: 14px; color: #34D399;"></i>
                3. Raspagem Forense de Posts
              </div>
              <p style="margin: 0; color: #94A3B8; line-height: 1.4;">
                Para perfis já conhecidos, permite extrair as últimas publicações, comentários, fotos de alta resolução, hashtags e gerar um dossiê pericial dark completo.
              </p>
            </div>
          </div>
        </section>

        <!-- Formulário de Busca com Abas de Modo -->
        <section class="redes-search-card">
          <!-- Abas de Seleção de Modo -->
          <div class="search-mode-tabs" style="display: flex; gap: 8px; margin-bottom: var(--space-4); border-bottom: 1px solid var(--color-border); padding-bottom: 12px; flex-wrap: wrap;">
            <button type="button" class="search-mode-tab active" id="tabModeUsername" data-mode="username" style="background: rgba(139, 92, 246, 0.18); color: #FFFFFF; border: 1px solid var(--color-primary); padding: 8px 16px; border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
              <i data-lucide="at-sign" style="width: 16px; height: 16px; color: var(--color-primary);"></i>
              Modo 1: Tenho o @Username (80+ Redes)
            </button>
            <button type="button" class="search-mode-tab" id="tabModePessoa" data-mode="pessoa" style="background: var(--color-surface-2); color: var(--color-text-muted); border: 1px solid var(--color-border); padding: 8px 16px; border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
              <i data-lucide="user-search" style="width: 16px; height: 16px; color: #38BDF8;"></i>
              Modo 2: Tenho Nome, E-mail ou Telefone
            </button>
            <button type="button" class="search-mode-tab" id="tabModeBrightData" data-mode="brightdata" style="background: var(--color-surface-2); color: var(--color-text-muted); border: 1px solid var(--color-border); padding: 8px 16px; border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
              <i data-lucide="radar" style="width: 16px; height: 16px; color: #F59E0B;"></i>
              Modo 3: Coleta Profunda de Posts
            </button>
          </div>

          <form id="formRedes">
            <!-- Painel do Modo 1: Focado em @Username (80+ Redes) -->
            <div id="panelModeUsername" style="display: block; margin-bottom: var(--space-4);">
              <div style="background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: var(--radius-md); padding: 18px;">
                <label for="inputUsername" style="font-size: 0.85rem; font-weight: 700; color: #F8FAFC; display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                  <i data-lucide="at-sign" style="width: 16px; height: 16px; color: var(--color-primary);"></i>
                  Informe o Nome de Usuário / Handle a Rastrear:
                </label>
                <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                  <div style="position: relative; flex: 1; min-width: 260px;">
                    <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 800; color: var(--color-primary); font-size: 1.15rem; font-family: var(--font-mono);">@</span>
                    <input
                      type="text"
                      id="inputUsername"
                      name="username"
                      class="redes-input-field"
                      style="padding-left: 36px; font-size: 1rem; font-weight: 600;"
                      placeholder="ex: carloseduardo, rafaeltoniato.adv, davitoria_adv"
                      autocomplete="off"
                    />
                  </div>
                  <button type="submit" class="btn btn-primary" id="btnSubmitRedes" style="padding: 10px 24px; white-space: nowrap;">
                    <i data-lucide="scan-search" style="width: 16px; height: 16px;"></i>
                    <span id="btnSubmitText">Rastrear Contas em 80+ Redes</span>
                  </button>
                </div>
                <div style="font-size: 0.76rem; color: var(--color-text-dim); margin-top: 8px;">
                  💡 <strong>O que esta busca faz:</strong> Varre instantaneamente se este usuário existe em Instagram, TikTok, X (Twitter), GitHub, Reddit, Pinterest, Twitch, Spotify, Steam, Telegram e mais 70 serviços online.
                </div>
              </div>
            </div>

            <!-- Painel do Modo 2: Cruzamento de Dados Pessoais (Nome, E-mail, Telefone) -->
            <div id="panelModePessoa" style="display: none; margin-bottom: var(--space-4);">
              <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-text); display: block; margin-bottom: 8px;">
                Preencha os dados conhecidos do alvo para descobrir os perfis em redes sociais:
              </span>

              <div class="redes-input-grid">
                <div>
                  <label for="inputNome" style="font-size: 0.75rem; color: var(--color-text-dim); display: block; margin-bottom: 2px;">Nome Completo</label>
                  <input
                    type="text"
                    id="inputNome"
                    name="nome"
                    class="redes-input-field"
                    placeholder="Ex: Carlos Eduardo Pereira"
                    autocomplete="off"
                  />
                </div>

                <div>
                  <label for="inputEmail" style="font-size: 0.75rem; color: var(--color-text-dim); display: block; margin-bottom: 2px;">E-mail do Alvo</label>
                  <input
                    type="email"
                    id="inputEmail"
                    name="email"
                    class="redes-input-field"
                    placeholder="alvo@gmail.com"
                    autocomplete="off"
                  />
                </div>

                <div>
                  <label for="inputTelefone" style="font-size: 0.75rem; color: var(--color-text-dim); display: block; margin-bottom: 2px;">Telefone com DDD</label>
                  <input
                    type="text"
                    id="inputTelefone"
                    name="telefone"
                    class="redes-input-field"
                    placeholder="(11) 98765-4321"
                    autocomplete="off"
                  />
                </div>

                <div>
                  <label for="selectProfissao" style="font-size: 0.75rem; color: var(--color-text-dim); display: block; margin-bottom: 2px;">Área Profissional / Título (Opcional)</label>
