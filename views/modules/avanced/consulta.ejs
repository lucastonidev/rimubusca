          <div id="consultaComplianceContainer" style="margin-top: var(--space-5); display: none;"></div>

          <!-- JSON Bruto Estruturado (Padrão: Oculto/Desativado) -->
          <div class="card" id="cardDadosBrutosJson" style="margin-top: var(--space-5); display: none;">
            <div class="card-header">
              <h3 class="card-title" style="display: flex; align-items: center; gap: 8px;">
                <i data-lucide="code" style="color: #A78BFA; width: 18px; height: 18px;"></i>
                <span>Dados Brutos (JSON)</span>
              </h3>
            </div>
            <pre style="background: var(--color-bg); padding: var(--space-4); border-radius: var(--radius-sm); border: 1px solid var(--color-border); font-family: var(--font-mono); font-size: 0.8125rem; color: #C4B5FD; overflow-x: auto; max-height: 400px;"><code id="resRawJson"></code></pre>
          </div>
        </div>

        <%- include('../../partials/footer') %>
