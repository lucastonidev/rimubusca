  <!-- MODAL DE RELATÓRIO / DOSSIÊ DARK OSINT                        -->
  <!-- ============================================================== -->
  <div id="modalRelatorioOsint" class="modal-relatorio-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalRelatorioTitle">
    <div class="modal-relatorio-dialog">
      <div class="modal-relatorio-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <div style="width: 32px; height: 32px; border-radius: 8px; background: linear-gradient(135deg, #7C3AED 0%, #4F46E5 100%); display: flex; align-items: center; justify-content: center; color: #FFFFFF;">
            <i data-lucide="file-text" style="width: 18px; height: 18px;"></i>
          </div>
          <div>
            <h2 id="modalRelatorioTitle" style="font-size: 1.125rem; font-weight: 700; color: #FFFFFF; margin: 0; display: flex; align-items: center; gap: 8px;">
              <span>Dossiê de Inteligência OSINT</span>
              <span class="badge" style="background: rgba(139, 92, 246, 0.2); color: #C4B5FD; font-size: 0.7rem; border: 1px solid rgba(139, 92, 246, 0.3);">
                CONFIDENCIAL
              </span>
            </h2>
            <p style="font-size: 0.75rem; color: #94A3B8; margin-top: 2px;">
              Dossiê oficial estruturado com padrão Dark Mode para exportação em PDF e HTML.
            </p>
          </div>
        </div>

        <div class="modal-relatorio-actions" style="display: flex; align-items: center; gap: 8px;">
          <button type="button" class="btn btn-outline btn-sm" id="btnGrafoModalRelatorioConsulta" style="border-color: rgba(6, 182, 212, 0.4); color: #22D3EE; background: rgba(6, 182, 212, 0.1); font-weight: 600;">
            <i data-lucide="share-2" style="width: 14px; height: 14px;"></i>
            <span>Ver Grafo de Vínculos</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btnGerarPdfRelatorio" style="background: linear-gradient(135deg, #7C3AED 0%, #4F46E5 100%); border-color: #8B5CF6; font-weight: 600;">
            <i data-lucide="file-down" style="width: 14px; height: 14px;"></i>
            <span>Exportar PDF</span>
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btnDownloadHtmlRelatorio" style="border-color: rgba(16, 185, 129, 0.4); color: #10B981; font-weight: 600;">
            <i data-lucide="download" style="width: 14px; height: 14px;"></i>
            <span>Baixar HTML</span>
          </button>
          <button type="button" class="btn btn-ghost btn-sm modal-close-btn" id="btnFecharModalRelatorio" title="Fechar (Esc)" style="color: #94A3B8; padding: 6px;">
            <i data-lucide="x" style="width: 20px; height: 20px;"></i>
          </button>
        </div>
      </div>

      <div class="modal-relatorio-body" id="modalRelatorioContent">
        <!-- Conteúdo do Relatório Injetado Dinamicamente -->
      </div>
    </div>
  </div>

