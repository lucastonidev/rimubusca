<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>

  <style>
    .consulta-box {
      background: radial-gradient(circle at 90% 10%, rgba(139, 92, 246, 0.08) 0%, transparent 60%),
                  var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      margin-bottom: var(--space-6);
      box-shadow: var(--shadow-sm);
    }

    /* ============================================================== */
    /* BARRA DE CATEGORIAS ESTILO HUBAPI                             */
    /* ============================================================== */
    .rimu-categories-bar {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      padding-bottom: 6px;
      margin-bottom: var(--space-4);
      scrollbar-width: thin;
    }

    .rimu-category-btn {
      padding: 8px 16px;
      font-size: 0.8125rem;
      font-weight: 600;
      border-radius: var(--radius-md);
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      white-space: nowrap;
      transition: all var(--transition-fast);
      user-select: none;
    }

    .rimu-category-btn:hover {
      background: var(--color-surface-3);
      color: var(--color-text);
      border-color: rgba(139, 92, 246, 0.4);
    }

    .rimu-category-btn.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.25) 0%, rgba(59, 130, 246, 0.2) 100%);
      border-color: #8B5CF6;
      color: #FFFFFF;
      font-weight: 700;
      box-shadow: 0 0 16px rgba(139, 92, 246, 0.25);
    }

    .rimu-cat-count {
      display: inline-block;
      font-size: 0.72rem;
      padding: 1px 6px;
      border-radius: 9999px;
      background: rgba(255, 255, 255, 0.08);
      font-family: var(--font-mono);
    }

    /* Barra de Busca de Módulos */
    .rimu-modules-search-wrap {
      position: relative;
      margin-bottom: var(--space-4);
    }

    .rimu-modules-search-wrap i,
    .rimu-modules-search-wrap svg {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-text-dim);
      pointer-events: none;
      width: 16px;
      height: 16px;
    }

    .rimu-modules-search-input {
      width: 100%;
      height: 42px;
      padding: 0 16px 0 42px;
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 0.875rem;
      outline: none;
      transition: all var(--transition-fast);
    }

    .rimu-modules-search-input:focus {
      border-color: #8B5CF6;
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
      background: var(--color-surface);
    }

    /* Grid Responsivo dos 43 Módulos */
    .rimu-modules-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--color-border);
      max-height: 220px;
      overflow-y: auto;
      scrollbar-width: thin;
      padding-right: 4px;
    }

    .rimu-mod-chip {
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 7px 12px;
      border-radius: var(--radius-md);
      font-size: 0.8125rem;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
      white-space: nowrap;
    }

    .rimu-mod-chip:hover {
      background-color: var(--color-surface-3);
      color: var(--color-text);
      border-color: rgba(139, 92, 246, 0.4);
      transform: translateY(-1px);
    }

    .rimu-mod-chip.active {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.3) 0%, rgba(239, 68, 68, 0.2) 100%);
      border-color: #8B5CF6;
      color: #FFFFFF;
      font-weight: 600;
      box-shadow: 0 0 15px rgba(139, 92, 246, 0.3);
    }

    .rimu-mod-chip.active i {
      color: #C4B5FD;
    }

    .rimu-mod-badge {
      font-size: 0.6875rem;
      padding: 1px 5px;
      border-radius: var(--radius-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    /* Painel do Módulo Selecionado (Hero Card) */
    .rimu-active-card {
      background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(13, 17, 26, 0.9) 100%);
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: var(--radius-md);
      padding: var(--space-4) var(--space-5);
      margin-bottom: var(--space-4);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-4);
      flex-wrap: wrap;
    }

    .rimu-active-title-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .rimu-active-icon-box {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      background: rgba(139, 92, 246, 0.15);
      border: 1px solid rgba(139, 92, 246, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #A78BFA;
    }

    .rimu-active-name {
      font-size: 1.0625rem;
      font-weight: 700;
      color: #FFFFFF;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .rimu-active-desc {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      margin-top: 2px;
    }

    /* Linhas de Entrada e Formulário */
    .consulta-input-row {
      display: flex;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }

    .consulta-input-field {
      flex: 1;
      padding: 12px 18px;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 1.0625rem;
      font-family: var(--font-mono);
      outline: none;
      transition: all var(--transition-fast);
    }

    .consulta-input-field:focus {
      border-color: #8B5CF6;
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
      background-color: var(--color-surface);
    }

    .consulta-param2-field {
      width: 140px;
      padding: 12px 14px;
      background-color: var(--color-surface-2);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 0.95rem;
      font-family: var(--font-mono);
      outline: none;
      transition: all var(--transition-fast);
    }

    .consulta-param2-field:focus {
      border-color: #8B5CF6;
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
      background-color: var(--color-surface);
    }

    .consulta-demo-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
      margin-top: var(--space-4);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-border);
    }

    .demo-consulta-btn {
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 4px 10px;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-family: var(--font-mono);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
    }

    .demo-consulta-btn:hover {
      background: var(--color-surface-3);
      color: #C4B5FD;
      border-color: rgba(139, 92, 246, 0.4);
    }

    @media (max-width: 640px) {
      .consulta-input-row {
        flex-direction: column;
      }
      .consulta-param2-field {
        width: 100%;
      }
    }

    /* ============================================================== */
    /* MODAL DO RELATÓRIO / DOSSIÊ DARK OSINT                        */
    /* ============================================================== */
    .modal-relatorio-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(4, 7, 13, 0.88);
      backdrop-filter: blur(8px);
      z-index: var(--z-modal, 9999);
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
      animation: fadeIn 0.2s ease-out;
    }

    .modal-relatorio-dialog {
      background: #080B11;
      border: 1px solid rgba(139, 92, 246, 0.35);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 980px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(139, 92, 246, 0.15);
      overflow: hidden;
    }

    .modal-relatorio-header {
      padding: var(--space-4) var(--space-6);
      background: #0D111A;
      border-bottom: 1px solid rgba(139, 92, 246, 0.2);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .modal-relatorio-body {
      padding: var(--space-6);
      overflow-y: auto;
      flex: 1;
      background: #080B11;
      color: #E2E8F0;
    }

    /* ============================================================== */
    /* ESTILOS DE IMPRESSÃO DARK MODE OSINT (@media print)            */
    /* Mantém tema escuro autêntico e isola 100% o relatório          */
    /* ============================================================== */
    @media print {
      @page {
        margin: 8mm;
        size: A4 portrait;
        background: #080B11 !important;
      }

      *, *::before, *::after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }

      html, body {
        background-color: #080B11 !important;
        background: #080B11 !important;
        color: #F1F5F9 !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: var(--font-sans, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif) !important;
      }

      /* OCULTA TOTALMENTE O SITE INTEIRO (LAYOUT, SIDEBAR, BUSCA E RESULTADOS DE FUNDO) */
      .app-layout,
      .sidebar,
      .sidebar-backdrop,
      .app-header,
      .app-main,
      .app-content,
      .consulta-box,
      #consultaResults,
      #consultaResultsContent,
      #consultaLoading,
      #consultaError,
      .tipo-tabs-bar,
      .consulta-demo-row,
      .app-footer,
      .bottom-nav,
      .command-palette-backdrop,
      .toast-container,
      #btnCopyConsultaJson,
      #btnNovaConsulta,
      #btnGerarRelatorioTop,
      .btn-filtro-pill,
      #inputFiltroPessoasTelefone,
      .modal-relatorio-actions,
      .modal-close-btn,
      #btnFecharModalRelatorio,
      .no-print,
      pre, code {
        display: none !important;
        visibility: hidden !important;
        height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
      }

      /* EXIBE EXCLUSIVAMENTE O MODAL DO RELATÓRIO */
      #modalRelatorioOsint {
        display: block !important;
        position: static !important;
        width: 100% !important;
        max-width: 100% !important;
        background: #080B11 !important;
        padding: 0 !important;
        margin: 0 !important;
        border: none !important;
        box-shadow: none !important;
      }

      .modal-relatorio-dialog {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        max-height: none !important;
        overflow: visible !important;
        background: #080B11 !important;
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .modal-relatorio-header {
        display: none !important;
      }

      .modal-relatorio-body {
        display: block !important;
        padding: 0 !important;
        overflow: visible !important;
        background: #080B11 !important;
      }

      .dark-report-container {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }

      .dark-report-card {
        background: #0D111A !important;
        border: 1px solid #1E2538 !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        margin-bottom: 12px !important;
      }
    }
  </style>
</head>
<body>
  <% const tipoAtivo = (typeof locals.tipoAtivo !== 'undefined' ? locals.tipoAtivo : (typeof locals.type !== 'undefined' ? locals.type : 'cpf')).toLowerCase(); %>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <%- include('../../partials/sidebar') %>

    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- Título do Módulo -->
        <div style="margin-bottom: var(--space-6);">
          <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text); display: flex; align-items: center; gap: 10px;">
            <i data-lucide="user-search" style="color: #A78BFA; width: 28px; height: 28px;"></i>
            <span>Central Unificada de Puxar Dados</span>
          </h1>
          <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 4px;">
            Consulte cadastros de pessoas físicas e jurídicas através de CPF, Nome, RG, Título, NIS, PIS, Parentes e mais.
          </p>
        </div>

        <!-- Caixa Principal de Consulta (RimuAPI Engine - 43 Módulos) -->
        <div class="consulta-box">
          <!-- 1. BARRA DE CATEGORIAS ESTILO HUBAPI -->
          <div class="rimu-categories-bar" id="rimuCategoriesBar">
            <button type="button" class="rimu-category-btn active" data-cat="todas">
              <i data-lucide="layout-grid" style="width: 15px; height: 15px;"></i>
              <span>Todas as Categorias</span>
              <span class="rimu-cat-count">43</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="pessoa">
              <i data-lucide="user" style="width: 15px; height: 15px;"></i>
              <span>Pessoa</span>
              <span class="rimu-cat-count">10</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="contato">
              <i data-lucide="phone-call" style="width: 15px; height: 15px;"></i>
              <span>Contato</span>
              <span class="rimu-cat-count">2</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="endereco">
              <i data-lucide="map-pin" style="width: 15px; height: 15px;"></i>
              <span>Endereço</span>
              <span class="rimu-cat-count">2</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="veiculos">
              <i data-lucide="car" style="width: 15px; height: 15px;"></i>
              <span>Veículos</span>
              <span class="rimu-cat-count">5</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="financeiro">
              <i data-lucide="trending-up" style="width: 15px; height: 15px;"></i>
              <span>Financeiro</span>
              <span class="rimu-cat-count">3</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="empresa">
              <i data-lucide="building-2" style="width: 15px; height: 15px;"></i>
              <span>Empresa & Jurídico</span>
              <span class="rimu-cat-count">8</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="familia">
              <i data-lucide="users" style="width: 15px; height: 15px;"></i>
              <span>Família</span>
              <span class="rimu-cat-count">4</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="vazados">
              <i data-lucide="shield-alert" style="width: 15px; height: 15px;"></i>
              <span>Vazados & Segurança</span>
              <span class="rimu-cat-count">5</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="geradores">
              <i data-lucide="cpu" style="width: 15px; height: 15px;"></i>
              <span>Geradores & Lotes</span>
              <span class="rimu-cat-count">4</span>
            </button>
          </div>

          <!-- 2. CAMPO DE BUSCA RÁPIDA DE MÓDULOS -->
          <div class="rimu-modules-search-wrap">
            <i data-lucide="search"></i>
            <input 
              type="text" 
              id="filtroModulosInput" 
              class="rimu-modules-search-input" 
              placeholder="🔍 Filtrar entre os 43 módulos da RimuAPI (ex: CPF, Score, OAB, Placa, CNPJ, Desmascarador, Vacina)..."
              autocomplete="off"
            >
          </div>

          <!-- 3. GRADE DE SELEÇÃO DOS 43 MÓDULOS OFICIAIS -->
          <div class="rimu-modules-grid" id="rimuModulesGrid">
            <!-- 1. PESSOA (10) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cpf' ? 'active' : '' %>" data-tipo="cpf" data-categoria="pessoa" data-nome="CPF Básico" data-badge="Oficial" data-badge-color="#10B981" data-desc="Consulta cadastral básica oficial de pessoa física (dados, contatos e endereços).">
              <i data-lucide="credit-card" style="width: 14px; height: 14px;"></i>
              <span>CPF Básico</span>
              <span class="rimu-mod-badge" style="background: rgba(16, 185, 129, 0.15); color: #10B981;">Oficial</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cpf_completo' ? 'active' : '' %>" data-tipo="cpf_completo" data-categoria="pessoa" data-nome="CPF PRO (Dossiê)" data-badge="PRO" data-badge-color="#8B5CF6" data-desc="Dossiê completo com dados biográficos, parentes, CNS, telefones e endereços vinculados.">
              <i data-lucide="shield-check" style="width: 14px; height: 14px; color: #10B981;"></i>
              <span>CPF PRO</span>
              <span class="rimu-mod-badge" style="background: rgba(139, 92, 246, 0.2); color: #C4B5FD;">PRO</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nome' ? 'active' : '' %>" data-tipo="nome" data-categoria="pessoa" data-nome="Nome Completo" data-badge="Lista" data-badge-color="#3B82F6" data-desc="Localização de CPFs, sexo e data de nascimento a partir do nome completo.">
              <i data-lucide="user" style="width: 14px; height: 14px;"></i>
              <span>Nome Completo</span>
              <span class="rimu-mod-badge" style="background: rgba(59, 130, 246, 0.15); color: #60A5FA;">Lista</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nome_similar' ? 'active' : '' %>" data-tipo="nome_similar" data-categoria="pessoa" data-nome="Nome Similar" data-badge="Fonético" data-badge-color="#6366F1" data-desc="Busca aproximada fonética/lexical de nomes e homônimos por primeiro e último nome.">
              <i data-lucide="search" style="width: 14px; height: 14px;"></i>
              <span>Nome Similar</span>
              <span class="rimu-mod-badge" style="background: rgba(99, 102, 241, 0.15); color: #818CF8;">Fonético</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'rg' ? 'active' : '' %>" data-tipo="rg" data-categoria="pessoa" data-nome="Registro Geral (RG)" data-badge="RG" data-badge-color="#06B6D4" data-desc="Busca de titular pelo número de RG e UF de expedição.">
              <i data-lucide="id-card" style="width: 14px; height: 14px;"></i>
              <span>RG</span>
              <span class="rimu-mod-badge" style="background: rgba(6, 182, 212, 0.15); color: #22D3EE;">RG</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'titulo' ? 'active' : '' %>" data-tipo="titulo" data-categoria="pessoa" data-nome="Título de Eleitor" data-badge="TSE" data-badge-color="#14B8A6" data-desc="Consulta de dados de pessoa física através dos 12 dígitos do Título Eleitoral.">
              <i data-lucide="vote" style="width: 14px; height: 14px;"></i>
              <span>Título Eleitor</span>
              <span class="rimu-mod-badge" style="background: rgba(20, 184, 166, 0.15); color: #2DD4BF;">TSE</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cns' ? 'active' : '' %>" data-tipo="cns" data-categoria="pessoa" data-nome="Cartão Nacional de Saúde (CNS)" data-badge="SUS" data-badge-color="#10B981" data-desc="Cartão Nacional de Saúde (CNS) com vínculos biográficos, contatos e residência.">
              <i data-lucide="activity" style="width: 14px; height: 14px;"></i>
              <span>CNS</span>
              <span class="rimu-mod-badge" style="background: rgba(16, 185, 129, 0.15); color: #34D399;">SUS</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nis' ? 'active' : '' %>" data-tipo="nis" data-categoria="pessoa" data-nome="NIS / PIS / PASEP" data-badge="Social" data-badge-color="#F59E0B" data-desc="Número de Identificação Social e benefícios sociais cadastrados.">
              <i data-lucide="badge-percent" style="width: 14px; height: 14px;"></i>
              <span>NIS</span>
              <span class="rimu-mod-badge" style="background: rgba(245, 158, 11, 0.15); color: #FBBF24;">Social</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'covid' ? 'active' : '' %>" data-tipo="covid" data-categoria="pessoa" data-nome="Vacinas COVID-19" data-badge="Vacinas" data-badge-color="#EC4899" data-desc="Histórico completo de vacinas, fabricantes, doses, lotes e postos de vacinação por CPF.">
              <i data-lucide="syringe" style="width: 14px; height: 14px;"></i>
              <span>Vacinas COVID</span>
              <span class="rimu-mod-badge" style="background: rgba(236, 72, 153, 0.15); color: #F472B6;">Vacinas</span>
            </button>

