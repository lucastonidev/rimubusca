  <script>
    window.__RIMU_MODULOS_DATA__ = <%- JSON.stringify(typeof modulos !== 'undefined' ? modulos : []) %>;
  </script>
  <script src="/js/ui.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/historico.js"></script>
  <script src="/js/main.js"></script>
  <script type="module" src="/js/interpreters/zeroy-interpreters.js?v=2.11"></script>
  <script defer src="/js/osint-dark-report.js?v=2.11"></script>
  <script defer src="/js/consulta.js?v=2.11"></script>
</body>
</html>

