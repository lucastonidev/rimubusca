<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>
  <link rel="stylesheet" href="/css/pages/consulta.css">
</head>
<body>
  <% const tipoAtivo = (typeof locals.tipoAtivo !== 'undefined' ? locals.tipoAtivo : (typeof locals.type !== 'undefined' ? locals.type : 'cpf')).toLowerCase(); %>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <%- include('../../partials/sidebar') %>

    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- Título do Módulo -->
        <div class="osint-page-header">
          <h1 class="osint-page-title">
            <i data-lucide="user-search" class="icon-xl icon-purple"></i>
            <span>Central Unificada de Puxar Dados</span>
          </h1>
          <p class="osint-page-subtitle">
            Consulte cadastros de pessoas físicas e jurídicas através de CPF, Nome, RG, Título, NIS, PIS, Parentes e mais.
          </p>
        </div>

        <!-- Caixa Principal de Consulta (RimuAPI Engine - 43 Módulos) -->
        <div class="consulta-box">
          <!-- 1. BARRA DE CATEGORIAS ESTILO HUBAPI -->
          <div class="rimu-categories-bar" id="rimuCategoriesBar">
            <button type="button" class="rimu-category-btn active" data-cat="todas">
              <i data-lucide="layout-grid"></i>
              <span>Todas as Categorias</span>
              <span class="rimu-cat-count">43</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="pessoa">
              <i data-lucide="user"></i>
              <span>Pessoa</span>
              <span class="rimu-cat-count">10</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="contato">
              <i data-lucide="phone-call"></i>
              <span>Contato</span>
              <span class="rimu-cat-count">2</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="endereco">
              <i data-lucide="map-pin"></i>
              <span>Endereço</span>
              <span class="rimu-cat-count">2</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="veiculos">
              <i data-lucide="car"></i>
              <span>Veículos</span>
              <span class="rimu-cat-count">5</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="financeiro">
              <i data-lucide="trending-up"></i>
              <span>Financeiro</span>
              <span class="rimu-cat-count">3</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="empresa">
              <i data-lucide="building-2"></i>
              <span>Empresa & Jurídico</span>
              <span class="rimu-cat-count">8</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="familia">
              <i data-lucide="users"></i>
              <span>Família</span>
              <span class="rimu-cat-count">4</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="vazados">
              <i data-lucide="shield-alert"></i>
              <span>Vazados & Segurança</span>
              <span class="rimu-cat-count">5</span>
            </button>

            <button type="button" class="rimu-category-btn" data-cat="geradores">
              <i data-lucide="cpu"></i>
              <span>Geradores & Lotes</span>
              <span class="rimu-cat-count">4</span>
            </button>
          </div>

          <!-- 2. CAMPO DE BUSCA RÁPIDA DE MÓDULOS -->
          <div class="rimu-modules-search-wrap">
            <i data-lucide="search"></i>
            <input 
              type="text" 
              id="filtroModulosInput" 
              class="rimu-modules-search-input" 
              placeholder="🔍 Filtrar entre os 43 módulos da RimuAPI (ex: CPF, Score, OAB, Placa, CNPJ, Desmascarador, Vacina)..."
              autocomplete="off"
            >
          </div>

          <!-- 3. GRADE DE SELEÇÃO DOS 43 MÓDULOS OFICIAIS -->
          <div class="rimu-modules-grid" id="rimuModulesGrid">
            <!-- 1. PESSOA (10) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cpf' ? 'active' : '' %>" data-tipo="cpf" data-categoria="pessoa" data-nome="CPF Básico" data-badge="Oficial" data-badge-color="#10B981" data-desc="Consulta cadastral básica oficial de pessoa física (dados, contatos e endereços).">
              <i data-lucide="credit-card"></i>
              <span>CPF Básico</span>
              <span class="rimu-mod-badge badge-tint-emerald">Oficial</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cpf_completo' ? 'active' : '' %>" data-tipo="cpf_completo" data-categoria="pessoa" data-nome="CPF PRO (Dossiê)" data-badge="PRO" data-badge-color="#8B5CF6" data-desc="Dossiê completo com dados biográficos, parentes, CNS, telefones e endereços vinculados.">
              <i data-lucide="shield-check" class="icon-emerald"></i>
              <span>CPF PRO</span>
              <span class="rimu-mod-badge badge-tint-purple">PRO</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nome' ? 'active' : '' %>" data-tipo="nome" data-categoria="pessoa" data-nome="Nome Completo" data-badge="Lista" data-badge-color="#3B82F6" data-desc="Localização de CPFs, sexo e data de nascimento a partir do nome completo.">
              <i data-lucide="user"></i>
              <span>Nome Completo</span>
              <span class="rimu-mod-badge badge-tint-blue">Lista</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nome_similar' ? 'active' : '' %>" data-tipo="nome_similar" data-categoria="pessoa" data-nome="Nome Similar" data-badge="Fonético" data-badge-color="#6366F1" data-desc="Busca aproximada fonética/lexical de nomes e homônimos por primeiro e último nome.">
              <i data-lucide="search"></i>
              <span>Nome Similar</span>
              <span class="rimu-mod-badge badge-tint-indigo">Fonético</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'rg' ? 'active' : '' %>" data-tipo="rg" data-categoria="pessoa" data-nome="Registro Geral (RG)" data-badge="RG" data-badge-color="#06B6D4" data-desc="Busca de titular pelo número de RG e UF de expedição.">
              <i data-lucide="id-card"></i>
              <span>RG</span>
              <span class="rimu-mod-badge badge-tint-cyan">RG</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'titulo' ? 'active' : '' %>" data-tipo="titulo" data-categoria="pessoa" data-nome="Título de Eleitor" data-badge="TSE" data-badge-color="#14B8A6" data-desc="Consulta de dados de pessoa física através dos 12 dígitos do Título Eleitoral.">
              <i data-lucide="vote"></i>
              <span>Título Eleitor</span>
              <span class="rimu-mod-badge badge-tint-teal">TSE</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cns' ? 'active' : '' %>" data-tipo="cns" data-categoria="pessoa" data-nome="Cartão Nacional de Saúde (CNS)" data-badge="SUS" data-badge-color="#10B981" data-desc="Cartão Nacional de Saúde (CNS) com vínculos biográficos, contatos e residência.">
              <i data-lucide="activity"></i>
              <span>CNS</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">SUS</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'nis' ? 'active' : '' %>" data-tipo="nis" data-categoria="pessoa" data-nome="NIS / PIS / PASEP" data-badge="Social" data-badge-color="#F59E0B" data-desc="Número de Identificação Social e benefícios sociais cadastrados.">
              <i data-lucide="badge-percent"></i>
              <span>NIS</span>
              <span class="rimu-mod-badge badge-tint-amber">Social</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'covid' ? 'active' : '' %>" data-tipo="covid" data-categoria="pessoa" data-nome="Vacinas COVID-19" data-badge="Vacinas" data-badge-color="#EC4899" data-desc="Histórico completo de vacinas, fabricantes, doses, lotes e postos de vacinação por CPF.">
              <i data-lucide="syringe"></i>
              <span>Vacinas COVID</span>
              <span class="rimu-mod-badge badge-tint-pink">Vacinas</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'fotos' || tipoAtivo === 'foto' ? 'active' : '' %>" data-tipo="fotos" data-categoria="pessoa" data-nome="Biometria Facial / Fotos" data-badge="Foto" data-badge-color="#A855F7" data-desc="Fotos oficiais registradas em documentos públicos (CNH/RG) em Base64 ou URL.">
              <i data-lucide="camera"></i>
              <span>Fotos / Facial</span>
              <span class="rimu-mod-badge badge-tint-violet">Foto</span>
            </button>

            <!-- 2. CONTATO (2) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'telefone' ? 'active' : '' %>" data-tipo="telefone" data-categoria="contato" data-nome="Telefone & Titularidade" data-badge="Telecom" data-badge-color="#3B82F6" data-desc="Localização de titular, operadora e endereços a partir do número de telefone com DDD.">
              <i data-lucide="phone"></i>
              <span>Telefone</span>
              <span class="rimu-mod-badge badge-tint-blue">Telecom</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'email' ? 'active' : '' %>" data-tipo="email" data-categoria="contato" data-nome="E-mail & Identidade Digital" data-badge="E-mail" data-badge-color="#6366F1" data-desc="Vínculos cadastrais, titularidade e redes associadas a um endereço de e-mail.">
              <i data-lucide="mail"></i>
              <span>E-mail</span>
              <span class="rimu-mod-badge badge-tint-indigo">E-mail</span>
            </button>

            <!-- 3. ENDEREÇO (2) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cep' ? 'active' : '' %>" data-tipo="cep" data-categoria="endereco" data-nome="CEP & Moradores" data-badge="CEP" data-badge-color="#10B981" data-desc="Residentes e logradouro por CEP simples, com suporte a número de residência opcional.">
              <i data-lucide="map-pin"></i>
              <span>CEP</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">CEP</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cep_avancado' ? 'active' : '' %>" data-tipo="cep_avancado" data-categoria="endereco" data-nome="CEP Avançado" data-badge="Avançado" data-badge-color="#8B5CF6" data-desc="Busca refinada de endereços e moradores por UF, logradouro, bairro e cidade.">
              <i data-lucide="map"></i>
              <span>CEP Avançado</span>
              <span class="rimu-mod-badge badge-tint-purple">Avançado</span>
            </button>

            <!-- 4. VEÍCULOS (5) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'placa' ? 'active' : '' %>" data-tipo="placa" data-categoria="veiculos" data-nome="Placa Padrão" data-badge="Veículo" data-badge-color="#F59E0B" data-desc="Consulta veicular padrão (marca, modelo, chassi, renavam, proprietário e restrições).">
              <i data-lucide="car"></i>
              <span>Placa</span>
              <span class="rimu-mod-badge badge-tint-amber">Veículo</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'placa_ghost' ? 'active' : '' %>" data-tipo="placa_ghost" data-categoria="veiculos" data-nome="Placa Ghost (Dossiê)" data-badge="Ghost PRO" data-badge-color="#EF4444" data-desc="Dossiê veicular completo com dados aprofundados do proprietário, CNH, telefones e endereços.">
              <i data-lucide="shield" class="icon-red"></i>
              <span>Placa Ghost</span>
              <span class="rimu-mod-badge badge-tint-red">Ghost PRO</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cnh' ? 'active' : '' %>" data-tipo="cnh" data-categoria="veiculos" data-nome="CNH / Habilitação" data-badge="Detran" data-badge-color="#10B981" data-desc="Carteira Nacional de Habilitação (número, categoria, validade e condutor por CNH ou CPF).">
              <i data-lucide="file-text"></i>
              <span>CNH</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">Detran</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'chassi' ? 'active' : '' %>" data-tipo="chassi" data-categoria="veiculos" data-nome="Chassi Veicular" data-badge="Chassi" data-badge-color="#6B7280" data-desc="Busca de histórico veicular diretamente pelo número de Chassi (17 caracteres).">
              <i data-lucide="binary"></i>
              <span>Chassi</span>
              <span class="rimu-mod-badge badge-tint-slate">17 Dígitos</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'renavam' ? 'active' : '' %>" data-tipo="renavam" data-categoria="veiculos" data-nome="Código RENAVAM" data-badge="Renavam" data-badge-color="#3B82F6" data-desc="Busca veicular completa diretamente pelo código RENAVAM do veículo.">
              <i data-lucide="hash"></i>
              <span>RENAVAM</span>
              <span class="rimu-mod-badge badge-tint-blue">Renavam</span>
            </button>

            <!-- 5. FINANCEIRO (3) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'score' ? 'active' : '' %>" data-tipo="score" data-categoria="financeiro" data-nome="Score de Crédito & Renda" data-badge="Crédito" data-badge-color="#F59E0B" data-desc="Pontuação de crédito estimada, renda presumida e classificação socioeconômica por CPF.">
              <i data-lucide="trending-up" class="icon-amber"></i>
              <span>Score</span>
              <span class="rimu-mod-badge badge-tint-amber">Crédito</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'aposentado' ? 'active' : '' %>" data-tipo="aposentado" data-categoria="financeiro" data-nome="INSS / Previdência" data-badge="INSS" data-badge-color="#10B981" data-desc="Benefícios previdenciários do INSS (aposentadoria, pensão, valores e agência pagadora).">
              <i data-lucide="heart-handshake"></i>
              <span>INSS</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">INSS</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'pis' ? 'active' : '' %>" data-tipo="pis" data-categoria="financeiro" data-nome="PIS / PASEP" data-badge="PIS" data-badge-color="#3B82F6" data-desc="Consulta cadastral formal de PIS / PASEP por CPF ou PIS.">
              <i data-lucide="briefcase"></i>
              <span>PIS</span>
              <span class="rimu-mod-badge badge-tint-blue">PIS</span>
            </button>

            <!-- 6. EMPRESA & JURÍDICO (8) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cnpj' ? 'active' : '' %>" data-tipo="cnpj" data-categoria="empresa" data-nome="CNPJ Completo (Receita)" data-badge="CNPJ" data-badge-color="#10B981" data-desc="Cadastro completo PJ (Empresa, Estabelecimento, Simples Nacional e Quadro de Sócios).">
              <i data-lucide="building-2"></i>
              <span>CNPJ</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">Receita</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cnpj2' ? 'active' : '' %>" data-tipo="cnpj2" data-categoria="empresa" data-nome="CNPJ Econômico (CNAEs)" data-badge="CNAEs" data-badge-color="#6366F1" data-desc="Consulta de CNPJ com ênfase nas atividades econômicas secundárias e CNAEs.">
              <i data-lucide="building"></i>
              <span>CNPJ CNAEs</span>
              <span class="rimu-mod-badge badge-tint-indigo">CNAEs</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'razao_social' ? 'active' : '' %>" data-tipo="razao_social" data-categoria="empresa" data-nome="Razão Social / Nome da Empresa" data-badge="Empresa" data-badge-color="#3B82F6" data-desc="Localização de empresas a partir da Razão Social ou Nome Empresarial.">
              <i data-lucide="briefcase"></i>
              <span>Razão Social</span>
              <span class="rimu-mod-badge badge-tint-blue">Nominal</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'socios' ? 'active' : '' %>" data-tipo="socios" data-categoria="empresa" data-nome="Quadro Societário (QSA)" data-badge="QSA" data-badge-color="#8B5CF6" data-desc="Consulta o Quadro de Sócios e Administradores (QSA) a partir do CNPJ da empresa.">
              <i data-lucide="users-round"></i>
              <span>Sócios QSA</span>
              <span class="rimu-mod-badge badge-tint-purple">QSA</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'socios2' ? 'active' : '' %>" data-tipo="socios2" data-categoria="empresa" data-nome="Sócios Avançado" data-badge="Cotas" data-badge-color="#A855F7" data-desc="Quadro societário avançado com participações cruzadas e percentual de capital pelo CNPJ da empresa.">
              <i data-lucide="network"></i>
              <span>Sócios Avançado</span>
              <span class="rimu-mod-badge badge-tint-violet">Cotas</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'funcionarios' ? 'active' : '' %>" data-tipo="funcionarios" data-categoria="empresa" data-nome="Funcionários por CNPJ" data-badge="Equipe" data-badge-color="#EC4899" data-desc="Relação de vínculos empregatícios ativos e funcionários registrados por CNPJ.">
              <i data-lucide="contact"></i>
              <span>Funcionários</span>
              <span class="rimu-mod-badge badge-tint-pink">Equipe</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'empregos' ? 'active' : '' %>" data-tipo="empregos" data-categoria="empresa" data-nome="Histórico Trabalhista (CTPS)" data-badge="CTPS" data-badge-color="#F59E0B" data-desc="Histórico formal de vínculos trabalhistas (CTPS/RAIS/CAGED) por CPF.">
              <i data-lucide="folder-clock"></i>
              <span>Empregos CTPS</span>
              <span class="rimu-mod-badge badge-tint-amber">CTPS</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'oab' ? 'active' : '' %>" data-tipo="oab" data-categoria="empresa" data-nome="Cadastro Nacional OAB / CNA" data-badge="Advogados" data-badge-color="#D97706" data-desc="Cadastro Nacional dos Advogados (CNA / OAB) por número de inscrição e seccional (UF).">
              <i data-lucide="scale"></i>
              <span>OAB Advogados</span>
              <span class="rimu-mod-badge badge-tint-amber">OAB</span>
            </button>

            <!-- 7. FAMÍLIA (4) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'mae' ? 'active' : '' %>" data-tipo="mae" data-categoria="familia" data-nome="Filhos por Nome da Mãe" data-badge="Mãe" data-badge-color="#EC4899" data-desc="Localização de filhos e dependentes a partir do nome completo da mãe.">
              <i data-lucide="heart"></i>
              <span>Mãe</span>
              <span class="rimu-mod-badge badge-tint-pink">Mãe</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'pai' ? 'active' : '' %>" data-tipo="pai" data-categoria="familia" data-nome="Filhos por Nome do Pai" data-badge="Pai" data-badge-color="#3B82F6" data-desc="Localização de filhos e dependentes a partir do nome completo do pai.">
              <i data-lucide="user-check"></i>
              <span>Pai</span>
              <span class="rimu-mod-badge badge-tint-blue">Pai</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'parentes' ? 'active' : '' %>" data-tipo="parentes" data-categoria="familia" data-nome="Parentes Diretos por CPF" data-badge="Parentesco" data-badge-color="#10B981" data-desc="Vínculos familiares diretos (pais, filhos, irmãos e cônjuges) por CPF.">
              <i data-lucide="users"></i>
              <span>Parentes</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">Família</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'arvore_familiar' ? 'active' : '' %>" data-tipo="arvore_familiar" data-categoria="familia" data-nome="Árvore Genealógica" data-badge="Genealogia" data-badge-color="#8B5CF6" data-desc="Rede genealógica ampliada com múltiplos graus de parentesco e afinidade.">
              <i data-lucide="git-fork"></i>
              <span>Árvore Genealógica</span>
              <span class="rimu-mod-badge badge-tint-purple">Genealogia</span>
            </button>

            <!-- 8. VAZADOS & SEGURANÇA (5) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'desmascarador' ? 'active' : '' %>" data-tipo="desmascarador" data-categoria="vazados" data-nome="Desmascarador de Dados / PIX" data-badge="Desofuscar" data-badge-color="#8B5CF6" data-desc="Revela dados completos de titulares de contas PIX cruzando o nome com os 6 dígitos centrais do CPF.">
              <i data-lucide="eye" class="icon-purple"></i>
              <span>Desmascarador</span>
              <span class="rimu-mod-badge badge-tint-purple-strong">PIX/*</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cloud_url' ? 'active' : '' %>" data-tipo="cloud_url" data-categoria="vazados" data-nome="Vazamentos por Domínio / URL" data-badge="URL" data-badge-color="#EF4444" data-desc="Credenciais e logs de acessos vazados associados a um domínio ou URL corporativa.">
              <i data-lucide="globe"></i>
              <span>Cloud URL</span>
              <span class="rimu-mod-badge badge-tint-red">Logs</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'cloud_usuario' ? 'active' : '' %>" data-tipo="cloud_usuario" data-categoria="vazados" data-nome="Vazamentos por Usuário" data-badge="Contas" data-badge-color="#F43F5E" data-desc="Vazamentos de senhas e acessos vinculados a um usuário específico ou e-mail.">
              <i data-lucide="user-x"></i>
              <span>Cloud Usuário</span>
              <span class="rimu-mod-badge badge-tint-rose">Contas</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'senha' ? 'active' : '' %>" data-tipo="senha" data-categoria="vazados" data-nome="Vazamentos por Senha / Hash" data-badge="Senha" data-badge-color="#DC2626" data-desc="Identifica contas e logins comprometidos associados a uma senha ou hash conhecido.">
              <i data-lucide="key"></i>
              <span>Vazamentos Senha</span>
              <span class="rimu-mod-badge badge-tint-red-soft">Senha</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'dump_cpf' ? 'active' : '' %>" data-tipo="dump_cpf" data-categoria="vazados" data-nome="Dump de CPFs Vazados" data-badge="Dump" data-badge-color="#B91C1C" data-desc="Extração em lote de registros e nomes a partir de fragmentos de CPFs vazados.">
              <i data-lucide="database"></i>
              <span>Dump CPF</span>
              <span class="rimu-mod-badge badge-tint-red">Dump</span>
            </button>

            <!-- 9. GERADORES & LOTES (4) -->
            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'dump_email' ? 'active' : '' %>" data-tipo="dump_email" data-categoria="geradores" data-nome="Dump de E-mails" data-badge="Lote" data-badge-color="#3B82F6" data-desc="Extração em lote de e-mails, titulares e telefones cadastrados por domínio.">
              <i data-lucide="at-sign"></i>
              <span>Dump E-mail</span>
              <span class="rimu-mod-badge badge-tint-blue">Lote</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'dump_telefone' ? 'active' : '' %>" data-tipo="dump_telefone" data-categoria="geradores" data-nome="Dump de Telefones" data-badge="Lote" data-badge-color="#0EA5E9" data-desc="Extração em lote de números de telefone e titulares a partir do DDD ou prefixo.">
              <i data-lucide="phone-forwarded"></i>
              <span>Dump Telefone</span>
              <span class="rimu-mod-badge badge-tint-sky">Lote</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'gerador_estado' ? 'active' : '' %>" data-tipo="gerador_estado" data-categoria="geradores" data-nome="Gerador por Estado (UF)" data-badge="Gerador" data-badge-color="#10B981" data-desc="Geração de dados cadastrais e estatísticos válidos por Estado / Unidade Federativa.">
              <i data-lucide="sparkles"></i>
              <span>Gerador Estado</span>
              <span class="rimu-mod-badge badge-tint-emerald-soft">UF</span>
            </button>

            <button type="button" class="rimu-mod-chip <%= tipoAtivo === 'gerador_cbo' ? 'active' : '' %>" data-tipo="gerador_cbo" data-categoria="geradores" data-nome="Consulta Ocupações (CBO)" data-badge="CBO" data-badge-color="#8B5CF6" data-desc="Consulta da Classificação Brasileira de Ocupações (CBO) com código e descrição.">
              <i data-lucide="award"></i>
              <span>Gerador CBO</span>
              <span class="rimu-mod-badge badge-tint-purple">CBO</span>
            </button>
          </div>

          <!-- 4. PAINEL HERO DO MÓDULO ATIVO -->
          <div class="rimu-active-card" id="rimuActiveCard">
            <div class="rimu-active-title-group">
              <div class="rimu-active-icon-box" id="rimuActiveIconBox">
                <i data-lucide="credit-card" id="rimuActiveIcon" class="icon-lg"></i>
              </div>
              <div>
                <div class="rimu-active-name">
                  <span id="rimuActiveTitle">CPF Básico</span>
                  <span class="rimu-mod-badge badge-tint-emerald" id="rimuActiveBadge">Oficial</span>
                </div>
                <div class="rimu-active-desc" id="rimuActiveDesc">
                  Consulta cadastral básica oficial de pessoa física (dados, contatos e endereços).
                </div>
              </div>
            </div>
            <div class="rimu-active-param-wrap">
              <span id="rimuActiveParamHint">Parâmetro: CPF (11 dígitos)</span>
            </div>
          </div>

          <!-- Alerta de Módulo em Manutenção ou Desativado -->
          <div id="rimuModuloManutencaoBanner" class="osint-banner-alert osint-banner-alert--danger consulta-maintenance-banner">
            <i data-lucide="alert-triangle" class="icon-lg icon-red"></i>
            <span id="rimuModuloManutencaoTexto">Este módulo está temporariamente em manutenção pela administração.</span>
          </div>

          <!-- 5. FORMULÁRIO DINÂMICO DE CONSULTA -->
          <form id="consultaForm">
            <label for="consultaInput" id="consultaInputLabel" class="consulta-input-label">
              Informe o Dado para Consulta:
            </label>

            <div class="consulta-input-row">
              <input 
                type="text" 
                id="consultaInput" 
                class="consulta-input-field input-osint" 
                placeholder="000.000.000-00" 
                required 
                autocomplete="off" 
                autofocus
              >

              <!-- Campo Secundário (Param2 / UF / Número) - exibido condicionalmente -->
              <div id="param2Container" class="consulta-param2-wrap">
                <input 
                  type="text" 
                  id="consultaInputParam2" 
                  class="consulta-param2-field input-osint-compact" 
                  placeholder="UF (ex: SP)"
                  autocomplete="off"
                >
              </div>

              <button type="submit" class="btn btn-primary btn-lg" id="btnSubmitConsulta">
                <i data-lucide="search" class="icon-sm"></i>
                <span>Puxar Dados</span>
              </button>
            </div>

            <!-- Botões de Demonstração Rápidos -->
            <div class="consulta-demo-row">
              <span class="consulta-demo-label">
                Dados de Teste:
              </span>

              <!-- CPF Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="cpf" data-val="12345678900">
                <span>🧪 Exemplo CPF (123.456.789-00)</span>
              </button>

              <!-- Nome Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="nome" data-val="Carlos Eduardo da Silva">
                <span>🧪 Exemplo Nome (Carlos Eduardo da Silva)</span>
              </button>

              <!-- RG Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="rg" data-val="38452190X">
                <span>🧪 Exemplo RG (38.452.190-X)</span>
              </button>

              <!-- Telefone Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="telefone" data-val="11911022367">
                <span>🧪 Exemplo Tel ((11) 91102-2367)</span>
              </button>

              <!-- Placa Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="placa" data-val="BRA2E19">
                <span>🧪 Exemplo Placa (BRA2E19)</span>
              </button>

              <!-- Operadora Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="operadora" data-val="11911022367">
                <span>🧪 Exemplo Operadora (11 91102-2367)</span>
              </button>

              <!-- Titulo Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="titulo" data-val="383692110132">
                <span>🧪 Exemplo Título (383692110132)</span>
              </button>

              <!-- Vizinhos Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="vizinhos" data-val="41877230804">
                <span>🧪 Exemplo Vizinhos (CPF)</span>
              </button>

              <!-- Parentes Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="parentes" data-val="Carlos Eduardo da Silva">
                <span>🧪 Exemplo Árvore Familiar</span>
              </button>

              <!-- CEP Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="cep" data-val="01310100">
                <span>🧪 Exemplo CEP (01310-100)</span>
              </button>

              <!-- Email Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="email" data-val="brunaalvesleite@hotmail.com">
                <span>🧪 Exemplo E-mail Pessoal</span>
              </button>

              <!-- Foto Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="foto" data-val="41877230804">
                <span>🧪 Exemplo Biometria Facial</span>
              </button>

              <!-- CPF PRO Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="cpf_completo" data-val="12345678900">
                <span>🧪 Exemplo CPF PRO</span>
              </button>

              <!-- Score Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="score" data-val="12345678900">
                <span>🧪 Exemplo Score & Renda</span>
              </button>

              <!-- INSS Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="aposentado" data-val="12345678900">
                <span>🧪 Exemplo INSS / Aposentadoria</span>
              </button>

              <!-- COVID-19 Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="covid" data-val="12345678900">
                <span>🧪 Exemplo Vacinas COVID</span>
              </button>

              <!-- OAB Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="oab" data-val="18442" data-param2="ES">
                <span>🧪 Exemplo OAB (18442 - ES)</span>
              </button>

              <!-- Mãe Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="mae" data-val="MARIA HELENA PEREIRA DA SILVA">
                <span>🧪 Exemplo Mãe (Filhos)</span>
              </button>

              <!-- Pai Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="pai" data-val="JOSE ROBERTO DA SILVA">
                <span>🧪 Exemplo Pai (Filhos)</span>
              </button>

              <!-- Razão Social Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="razao_social" data-val="PETROBRAS">
                <span>🧪 Exemplo Razão Social (PETROBRAS)</span>
              </button>

              <!-- Sócios Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="socios" data-val="33000167000101">
                <span>🧪 Exemplo Sócios QSA (Petrobras)</span>
              </button>

              <!-- Desmascarador Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="desmascarador" data-val="BRUNA ALVES LEITE" data-param2="772308">
                <span>🧪 Exemplo PIX (BRUNA ALVES LEITE - ***.772.308-**)</span>
              </button>

              <!-- Cloud URL Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="cloud_url" data-val="empresa.com.br">
                <span>🧪 Exemplo Cloud URL Vazamentos</span>
              </button>

              <!-- CNPJ Demo -->
              <button type="button" class="demo-consulta-btn" data-tipo="cnpj" data-val="33000167000101">
                <span>🧪 Exemplo CNPJ (PETROBRAS)</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Estado de Carregamento (Loading) -->
        <div id="consultaLoading" class="consulta-state-box">
          <div class="card osint-loading-card">
            <div class="osint-spinner"></div>
            <h3 class="osint-loading-title">
              Puxando Dados Cadastrais...
            </h3>
            <p class="osint-loading-sub">
              Consultando bases e adaptadores de integração...
            </p>
          </div>
        </div>

        <!-- Estado de Erro -->
        <div id="consultaError" class="consulta-state-box">
          <div class="card osint-error-card">
            <div class="osint-error-row">
              <i data-lucide="alert-circle" class="icon-lg icon-red"></i>
              <div>
                <strong class="osint-error-title">Erro na Consulta:</strong>
                <span id="consultaErrorMessage" class="osint-error-msg"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Resultados da Consulta -->
        <div id="consultaResults" class="consulta-results-box">
          <!-- Barra Superior de Controle -->
          <div class="osint-toolbar">
            <div class="osint-toolbar-group">
              <span id="resTipoBadge" class="badge badge-purple">MÓDULO: CPF</span>
              <span id="resFonteText" class="badge badge-dark">Fonte</span>
              <span id="resCreditsBadge" class="badge badge-emerald"></span>
            </div>

            <div class="osint-toolbar-group">
              <button type="button" class="btn btn-outline btn-sm btn-osint-cyan" id="btnAbrirGrafoConsulta">
                <i data-lucide="share-2" class="icon-sm"></i>
                <span>Grafo de Vínculos</span>
              </button>
              <button type="button" class="btn btn-primary btn-sm btn-osint-violet" id="btnGerarRelatorioTop">
                <i data-lucide="file-text" class="icon-sm"></i>
                <span>Gerar Relatório</span>
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="btnCopyConsultaJson">
                <i data-lucide="copy" class="icon-sm"></i>
                <span>Copiar JSON</span>
              </button>
              <button type="button" class="btn btn-outline btn-sm" id="btnNovaConsulta">
                <i data-lucide="refresh-cw" class="icon-sm"></i>
                <span>Nova Consulta</span>
              </button>
            </div>
          </div>

          <!-- Conteúdo Dinâmico dos Dados -->
          <div id="consultaResultsContent"></div>

          <!-- Painel Integrado de Compliance Público (CGU / CEIS / TSE / PNCP / Diários Oficiais) -->
          <div id="consultaComplianceContainer" class="consulta-compliance-box"></div>

          <!-- JSON Bruto Estruturado (Padrão: Oculto/Desativado) -->
          <div class="card consulta-raw-card" id="cardDadosBrutosJson">
            <div class="card-header">
              <h3 class="card-title">
                <i data-lucide="code" class="icon-md icon-purple"></i>
                <span>Dados Brutos (JSON)</span>
              </h3>
            </div>
            <pre class="osint-code-pre"><code id="resRawJson"></code></pre>
          </div>
        </div>

        <%- include('../../partials/footer') %>
      </main>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- MODAL DE RELATÓRIO / DOSSIÊ DARK OSINT                        -->
  <!-- ============================================================== -->
  <div id="modalRelatorioOsint" class="modal-relatorio-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalRelatorioTitle">
    <div class="modal-relatorio-dialog">
      <div class="modal-relatorio-header">
        <div class="modal-relatorio-brand">
          <div class="modal-relatorio-icon-badge">
            <i data-lucide="file-text" class="icon-md"></i>
          </div>
          <div>
            <h2 id="modalRelatorioTitle" class="modal-relatorio-title">
              <span>Dossiê de Inteligência OSINT</span>
              <span class="badge badge-purple">
                CONFIDENCIAL
              </span>
            </h2>
            <p class="modal-relatorio-subtitle">
              Dossiê oficial estruturado com padrão Dark Mode para exportação em PDF e HTML.
            </p>
          </div>
        </div>

        <div class="modal-relatorio-actions">
          <button type="button" class="btn btn-outline btn-sm btn-osint-cyan" id="btnGrafoModalRelatorioConsulta">
            <i data-lucide="share-2" class="icon-sm"></i>
            <span>Ver Grafo de Vínculos</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm btn-osint-violet" id="btnGerarPdfRelatorio">
            <i data-lucide="file-down" class="icon-sm"></i>
            <span>Exportar PDF</span>
          </button>
          <button type="button" class="btn btn-outline btn-sm btn-osint-emerald" id="btnDownloadHtmlRelatorio">
            <i data-lucide="download" class="icon-sm"></i>
            <span>Baixar HTML</span>
          </button>
          <button type="button" class="btn btn-ghost btn-sm modal-close-btn" id="btnFecharModalRelatorio" title="Fechar (Esc)">
            <i data-lucide="x" class="icon-lg"></i>
          </button>
        </div>
      </div>

      <div class="modal-relatorio-body" id="modalRelatorioContent">
        <!-- Conteúdo do Relatório Injetado Dinamicamente -->
      </div>
    </div>
  </div>

  <%- include('../../partials/bottom-nav') %>
  <%- include('../../partials/command-palette') %>
  <%- include('../../partials/toast') %>

