<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../../partials/head') %>

  <style>
    /* ==========================================================================
       RIMUBUSCA - CATÁLOGO DE APIS PAY-PER-USE / ASPECT HUB (ESTILOS DEDICADOS)
       ========================================================================== */

    .hub-hero-section {
      background: radial-gradient(circle at 95% 5%, rgba(245, 158, 11, 0.12) 0%, transparent 60%),
                  radial-gradient(circle at 5% 95%, rgba(139, 92, 246, 0.08) 0%, transparent 50%),
                  var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: var(--space-6);
      margin-bottom: var(--space-6);
      box-shadow: var(--shadow-sm);
    }

    .hub-hero-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .hub-hero-title-group h1 {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--color-text);
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
    }

    .hub-hero-title-group p {
      color: var(--color-text-muted);
      font-size: 0.95rem;
      max-width: 720px;
      line-height: 1.5;
    }

    /* Carteira / Orçamento Mensal (Fintech Glass Panel) */
    .hub-wallet-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(24, 24, 27, 0.85) 100%);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: var(--radius-lg);
      padding: var(--space-5);
      display: grid;
      grid-template-columns: 1.4fr 1.2fr;
      gap: var(--space-6);
      align-items: center;
      box-shadow: 0 8px 32px -4px rgba(0, 0, 0, 0.5);
      position: relative;
      overflow: hidden;
    }

    @media (max-width: 992px) {
      .hub-wallet-card {
        grid-template-columns: 1fr;
        gap: var(--space-4);
      }
    }

    .hub-wallet-card::before {
      content: "";
      position: absolute;
      top: -50px;
      right: -50px;
      width: 140px;
      height: 140px;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .hub-wallet-balance-box {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .hub-wallet-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: #F59E0B;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .hub-wallet-amount {
      font-size: 2.25rem;
      font-weight: 800;
      color: #10B981;
      font-family: var(--font-mono);
      letter-spacing: -1px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .hub-wallet-budget-sub {
      font-size: 0.825rem;
      color: var(--color-text-dim);
    }

    .hub-wallet-progress-wrap {
      width: 100%;
      margin-top: 4px;
    }

    .hub-wallet-progress-track {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 9999px;
      overflow: hidden;
      margin-bottom: 6px;
    }

    .hub-wallet-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, #10B981 0%, #F59E0B 100%);
      border-radius: 9999px;
      transition: width 0.4s ease;
    }

    .hub-wallet-stats-col {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding: 0 var(--space-4);
      border-left: 1px solid rgba(255, 255, 255, 0.06);
      border-right: 1px solid rgba(255, 255, 255, 0.06);
    }

    @media (max-width: 992px) {
      .hub-wallet-stats-col {
        border-left: none;
        border-right: none;
        padding: var(--space-2) 0;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }
    }

    .hub-stat-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
    }

    .hub-stat-label {
      color: var(--color-text-muted);
    }

    .hub-stat-value {
      font-weight: 700;
      color: var(--color-text);
      font-family: var(--font-mono);
    }

    .hub-wallet-actions {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      justify-content: center;
    }

    /* Barra de Filtros e Busca */
    .hub-controls-bar {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .hub-search-row {
      display: flex;
      gap: var(--space-3);
      align-items: center;
    }

    .hub-search-box {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
    }

    .hub-search-box svg,
    .hub-search-box i,
    .hub-search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--color-text-dim);
      pointer-events: none;
      width: 18px;
      height: 18px;
      z-index: 2;
    }

    .hub-search-input {
      width: 100%;
      height: 46px;
      padding: 0 16px 0 44px;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      color: var(--color-text);
      font-size: 0.925rem;
      font-family: var(--font-sans);
      outline: none;
      transition: all var(--transition-fast);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .hub-search-input::placeholder {
      color: var(--color-text-dim);
      font-size: 0.875rem;
    }

    .hub-search-input:focus {
      border-color: #F59E0B;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.18);
      background: var(--color-surface-2);
    }

    .hub-categories-tabs {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: thin;
    }

    .hub-tab-btn {
      padding: 8px 16px;
      font-size: 0.825rem;
      font-weight: 600;
      border-radius: var(--radius-md);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      transition: all var(--transition-fast);
    }

    .hub-tab-btn:hover {
      color: var(--color-text);
      border-color: rgba(245, 158, 11, 0.4);
    }

    .hub-tab-btn.active {
      background: rgba(245, 158, 11, 0.15);
      border-color: #F59E0B;
      color: #F59E0B;
    }

    .hub-tab-count {
      padding: 2px 6px;
      border-radius: 9999px;
      font-size: 0.7rem;
      background: rgba(255, 255, 255, 0.08);
      color: inherit;
    }

    /* Seções e Grade de Cards */
    .hub-category-section {
      margin-bottom: var(--space-8);
    }

    .hub-section-header {
      margin-bottom: var(--space-4);
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-bottom: 1px solid var(--color-border);
      padding-bottom: var(--space-2);
    }

    .hub-section-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-text);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .hub-section-desc {
      font-size: 0.825rem;
      color: var(--color-text-dim);
    }

    .hub-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }

    @media (min-width: 1400px) {
      .hub-cards-grid {
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 26px;
      }
    }

    @media (max-width: 640px) {
      .hub-cards-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }

    /* Card de Módulo Individual (Estilo Moderno & Espaçado) */
    .hub-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 16px;
      transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
      position: relative;
      cursor: pointer;
      min-height: 250px;
    }

    .hub-card:hover {
      transform: translateY(-3px);
      border-color: rgba(245, 158, 11, 0.45);
      box-shadow: 0 12px 30px -6px rgba(0, 0, 0, 0.55);
    }

    .hub-card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2px;
    }

    .hub-cost-tag {
      font-size: 0.95rem;
      font-weight: 800;
      color: #F59E0B;
      font-family: var(--font-mono);
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      padding: 5px 12px;
      border-radius: var(--radius-sm);
      letter-spacing: 0.3px;
    }

    .hub-card-body {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 0;
    }

    .hub-card-icon {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      background: var(--color-surface-2);
      border: 1px solid var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    }

    .hub-card-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--color-text);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .hub-card-desc {
      font-size: 0.825rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      min-height: 2.5em;
    }
    }

    /* BARRA DE PROGRESSO DO SALDO NO CARD (REQUISITO FUNDAMENTAL) */
    .hub-card-balance-metric {
      background: var(--color-surface-2);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: var(--radius-md);
      padding: 8px 10px;
      margin-bottom: var(--space-3);
    }

    .hub-card-prog-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.75rem;
      margin-bottom: 6px;
    }

    .hub-card-prog-label {
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .hub-card-prog-count {
      font-family: var(--font-mono);
      font-weight: 700;
      color: #10B981;
    }

    .hub-card-prog-track {
      width: 100%;
      height: 6px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      overflow: hidden;
    }

    .hub-card-prog-fill {
      height: 100%;
      background: linear-gradient(90deg, #10B981, #F59E0B);
      border-radius: 9999px;
      transition: width 0.3s ease;
    }

    .hub-card-prog-fill.low-balance {
      background: #EF4444;
    }

    .hub-card-prog-fill.mid-balance {
      background: #F59E0B;
    }

    .hub-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2);
      border-top: 1px solid var(--color-border);
      padding-top: var(--space-3);
    }

    .hub-param-hint {
      font-size: 0.725rem;
      color: var(--color-text-dim);
      font-family: var(--font-mono);
      display: flex;
      align-items: center;
      gap: 4px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .hub-btn-consultar {
      padding: 7px 14px;
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: var(--radius-md);
      background: #8B5CF6;
      color: white;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition-fast);
      white-space: nowrap;
    }

    .hub-btn-consultar:hover {
      background: #7C3AED;
      box-shadow: 0 0 12px rgba(139, 92, 246, 0.4);
    }

    .hub-btn-consultar:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      background: var(--color-surface-3);
      color: var(--color-text-dim);
    }

    /* Modal Backdrop & Dialogs */
    .hub-modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      padding: var(--space-4);
    }

    .hub-modal-backdrop.active {
      display: flex;
    }

    .hub-modal-dialog {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      width: 100%;
      max-width: 640px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7);
      animation: hubModalIn 0.2s ease-out;
      overflow: hidden;
    }

    @keyframes hubModalIn {
      from {
        opacity: 0;
        transform: scale(0.96) translateY(10px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    .hub-modal-header {
      padding: var(--space-5);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .hub-modal-title {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--color-text);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .hub-modal-close-btn {
      background: none;
      border: none;
      color: var(--color-text-dim);
      cursor: pointer;
      padding: 6px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition-fast);
    }

    .hub-modal-close-btn:hover {
      color: var(--color-text);
      background: rgba(255, 255, 255, 0.08);
    }

    .hub-modal-body {
      padding: var(--space-5);
      overflow-y: auto;
      max-height: calc(90vh - 140px);
    }

    .hub-modal-footer {
      padding: var(--space-4) var(--space-5);
      border-top: 1px solid var(--color-border);
      display: flex;
      justify-content: flex-end;
      gap: var(--space-3);
      background: var(--color-surface-2);
    }

    /* Caixa de Resumo de Débito no Modal */
    .hub-debit-summary-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.1) 0%, rgba(139, 92, 246, 0.05) 100%);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      margin-bottom: var(--space-5);
    }

    .hub-debit-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      margin-bottom: 6px;
    }

    .hub-debit-row:last-child {
      margin-bottom: 0;
      padding-top: 6px;
      border-top: 1px dashed rgba(255, 255, 255, 0.1);
      font-weight: 700;
    }

    /* JSON Viewer */
    .hub-json-pre {
      background: #0D1117;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      padding: var(--space-4);
      font-family: var(--font-mono);
      font-size: 0.825rem;
      color: #58A6FF;
      max-height: 380px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-all;
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <!-- Backdrop Mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <!-- Barra Lateral -->
    <%- include('../../partials/sidebar') %>

    <!-- Área Principal de Conteúdo -->
    <div class="app-main">
      <%- include('../../partials/header') %>

      <main class="app-content">
        <!-- 1. HERO & STATUS DA CARTEIRA PRÉ-PAGA -->
        <section class="hub-hero-section">
          <div class="hub-hero-header">
            <div class="hub-hero-title-group">
              <h1>
                <i data-lucide="coins" style="color: #F59E0B; width: 28px; height: 28px;"></i>
                <span>Catálogo de Puxar Dados 2</span>
              </h1>
              <p>
                Explore todas as 46 APIs disponíveis sob demanda da plataforma Zeroy API.
                Orçamento centralizado e compartilhado com saldo comum entre todos os operadores e monitoramento de consumo em tempo real.
              </p>
            </div>

            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <span class="badge badge-success" style="font-weight: 700; background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3);">
                <i data-lucide="users" style="width: 12px; height: 12px; display: inline;"></i> SALDO COMPARTILHADO (TODOS OS USUÁRIOS)
              </span>
              <span class="badge badge-warning" style="font-weight: 700;"><%= typeof carteira !== 'undefined' && carteira && carteira.totalModulos ? carteira.totalModulos : 29 %> MÓDULOS ATIVOS</span>
              <span class="badge badge-purple" style="font-weight: 700;">ZEROY API CONECTADA</span>
            </div>
          </div>

          <!-- Card de Carteira & Gestão de Orçamento Compartilhado -->
          <div class="hub-wallet-card">
            <!-- Coluna 1: Saldo Disponível & Barra Geral -->
            <div class="hub-wallet-balance-box">
              <span class="hub-wallet-label">
                <i data-lucide="wallet" style="width: 14px; height: 14px;"></i>
                Saldo Compartilhado Disponível
              </span>
              <div class="hub-wallet-amount">
                <span id="carteiraSaldoDisplay"><%= typeof carteira !== 'undefined' && carteira && carteira.saldoFormatado ? carteira.saldoFormatado : 'R$ 20,00' %></span>
              </div>
              <div class="hub-wallet-budget-sub">
                Orçamento planejado: <strong id="carteiraOrcamentoDisplay"><%= typeof carteira !== 'undefined' && carteira && carteira.orcamentoFormatado ? carteira.orcamentoFormatado : 'R$ 20,00' %>/mês</strong>
              </div>

              <div class="hub-wallet-progress-wrap">
                <div class="hub-wallet-progress-track">
                  <div class="hub-wallet-progress-fill" id="carteiraProgressFill" style="width: <%= typeof carteira !== 'undefined' && carteira && typeof carteira.percentualSaldo === 'number' ? carteira.percentualSaldo : 100 %>%;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.725rem; color: var(--color-text-dim);">
                  <span id="carteiraPercentualLabel"><%= typeof carteira !== 'undefined' && carteira && typeof carteira.percentualSaldo === 'number' ? carteira.percentualSaldo : 100 %>% restante</span>
                  <span>Capacidade da Equipe</span>
                </div>
              </div>
            </div>

            <!-- Coluna 2: Métricas de Uso -->
            <div class="hub-wallet-stats-col">
              <div class="hub-stat-item">
                <span class="hub-stat-label">Total Gasto (Equipe):</span>
                <span class="hub-stat-value" id="carteiraGastoDisplay" style="color: #EF4444;"><%= typeof carteira !== 'undefined' && carteira && carteira.totalGastoFormatado ? carteira.totalGastoFormatado : 'R$ 0,00' %></span>
              </div>
              <div class="hub-stat-item">
                <span class="hub-stat-label">Consultas Realizadas:</span>
                <span class="hub-stat-value" id="carteiraConsultasDisplay"><%= typeof carteira !== 'undefined' && carteira && typeof carteira.totalConsultas === 'number' ? carteira.totalConsultas : 0 %></span>
              </div>
              <div class="hub-stat-item">
                <span class="hub-stat-label">Total de Módulos:</span>
                <span class="hub-stat-value"><%= typeof carteira !== 'undefined' && carteira && carteira.totalModulos ? carteira.totalModulos : 29 %> APIs</span>
              </div>
              <div class="hub-stat-item">
                <span class="hub-stat-label">Menor Custo:</span>
                <span class="hub-stat-value" style="color: #10B981;">R$ 0,08 (CPF/CNPJ)</span>
              </div>
            </div>
          </div>
        </section>

        <!-- 2. CONTROLES: BUSCA E FILTRO DE CATEGORIAS -->
        <section class="hub-controls-bar">
          <!-- Campo de Busca Rápida -->
          <div class="hub-search-row">
            <div class="hub-search-box">
              <i data-lucide="search" class="hub-search-icon"></i>
              <input
                type="text"
                id="hubSearchInput"
                class="hub-search-input"
                placeholder="Buscar módulo por nome, parâmetro (ex: cpf, placa, chassi, score) ou palavra-chave..."
                autocomplete="off"
              />
            </div>
            <button type="button" class="btn btn-outline" id="btnLimparBusca" title="Limpar busca" style="display: none;">
              <i data-lucide="x" style="width: 16px; height: 16px;"></i>
            </button>
          </div>

          <!-- Abas de Categorias -->
          <div class="hub-categories-tabs">
            <button type="button" class="hub-tab-btn active" data-categoria="todas">
              <i data-lucide="layers" style="width: 15px; height: 15px;"></i>
              <span>Todas as APIs</span>
              <span class="hub-tab-count" id="count-todas"><%= typeof carteira !== 'undefined' && carteira && carteira.totalModulos ? carteira.totalModulos : 29 %></span>
            </button>
            <button type="button" class="hub-tab-btn" data-categoria="cadastrais">
              <i data-lucide="user-check" style="width: 15px; height: 15px;"></i>
              <span>Dados Cadastrais & Pessoal</span>
