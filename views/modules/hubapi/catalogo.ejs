            <span style="font-size: 0.7rem; color: var(--color-text-dim);">Plano Mensal (375x)</span>
          </button>
          <button type="button" class="btn btn-outline btn-preset-recarga" data-valor="50" style="flex-direction: column; padding: 12px; gap: 4px;">
            <span style="font-size: 1.1rem; font-weight: 700; color: var(--color-text);">+ R$ 50</span>
            <span style="font-size: 0.7rem; color: var(--color-text-dim);">~625 consultas</span>
          </button>
        </div>

        <div style="margin-bottom: var(--space-4);">
          <label for="inputValorRecarga" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text); margin-bottom: 6px; display: block;">
            Valor da Recarga (R$)
          </label>
          <input
            type="number"
            id="inputValorRecarga"
            class="hub-search-input"
            value="30"
            min="1"
            max="5000"
            step="any"
            style="padding-left: 14px; font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700;"
          />
        </div>

        <div style="background: rgba(255, 255, 255, 0.04); border-radius: var(--radius-md); padding: 12px; border: 1px dashed var(--color-border);">
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 4px;">
            <span style="color: var(--color-text-muted);">Saldo Atual:</span>
            <span style="font-weight: 700; color: #10B981;" id="recargaSaldoAtualDisplay">R$ 30,00</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.85rem;">
            <span style="color: var(--color-text-muted);">Saldo Final Previsto:</span>
            <span style="font-weight: 700; color: #F59E0B;" id="recargaSaldoFinalDisplay">R$ 60,00</span>
          </div>
        </div>
      </div>

      <div class="hub-modal-footer">
        <button type="button" class="btn btn-outline" id="btnCancelarRecarga">Cancelar</button>
        <button type="button" class="btn btn-primary" id="btnConfirmarRecarga" style="background: #F59E0B; border-color: #D97706; color: #111827; font-weight: 700;">
          <i data-lucide="check" style="width: 16px; height: 16px;"></i>
          <span>Confirmar Recarga</span>
        </button>
      </div>
    </div>
  </div>

  <!-- MODAL 3: EXTRATO / HISTÓRICO DE DÉBITOS -->
  <div id="modalExtrato" class="hub-modal-backdrop" role="dialog" aria-modal="true" aria-label="Extrato da Carteira">
    <div class="hub-modal-dialog" style="max-width: 680px;">
      <div class="hub-modal-header">
        <div class="hub-modal-title">
          <i data-lucide="receipt" style="color: #60A5FA; width: 22px; height: 22px;"></i>
          <span>Extrato de Consultas & Débitos</span>
        </div>
        <button type="button" class="hub-modal-close-btn" id="btnFecharModalExtrato" title="Fechar (Esc)">
          <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </button>
      </div>

      <div class="hub-modal-body">
        <div id="extratoListContainer">
          <!-- Renderizado via /js/hubapi.js -->
        </div>
      </div>

      <div class="hub-modal-footer">
        <button type="button" class="btn btn-outline" id="btnFecharExtratoFooter">Fechar</button>
      </div>
    </div>
  </div>

  <!-- Barra de Navegação Inferior (Mobile) -->
  <%- include('../../partials/bottom-nav') %>

  <!-- Modal de Busca Global (Ctrl + K) -->
  <%- include('../../partials/command-palette') %>

  <!-- Container de Mensagens Toast -->
  <%- include('../../partials/toast') %>

  <!-- Scripts Base & Hub API -->
  <script src="/js/ui.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/classes/HubClient.js"></script>
  <script src="/js/hubapi.js"></script>
</body>
</html>

