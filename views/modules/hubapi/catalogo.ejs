  <!-- MODAL 1: EXECUTAR CONSULTA PAY-PER-USE -->
  <div id="modalExecutarConsulta" class="hub-modal-backdrop" role="dialog" aria-modal="true" aria-label="Executar Consulta Pay-per-Use">
    <div class="hub-modal-dialog">
      <div class="hub-modal-header">
        <div class="hub-modal-title">
          <div id="modalModIcon" style="display: flex; align-items: center; color: #8B5CF6;">
            <i data-lucide="search" style="width: 22px; height: 22px;"></i>
          </div>
          <span id="modalModNome">Módulo CPF (Live)</span>
        </div>
        <button type="button" class="hub-modal-close-btn" id="btnFecharModalConsulta" title="Fechar (Esc)">
          <i data-lucide="x" style="width: 20px; height: 20px;"></i>
        </button>
      </div>

      <div class="hub-modal-body">
        <!-- Resumo de Débito e Saldo -->
        <div class="hub-debit-summary-card">
          <div class="hub-debit-row">
            <span style="color: var(--color-text-muted);">Custo da Consulta:</span>
            <span style="color: #F59E0B; font-family: var(--font-mono); font-weight: 700;" id="modalModCusto">R$ 0,08</span>
          </div>
          <div class="hub-debit-row">
            <span style="color: var(--color-text-muted);">Seu Saldo Atual:</span>
            <span style="color: #10B981; font-family: var(--font-mono); font-weight: 700;" id="modalSaldoAtual">R$ 30,00</span>
          </div>
          <div class="hub-debit-row">
            <span style="color: var(--color-text);">Saldo Previsto Após Consulta:</span>
            <span style="color: var(--color-text); font-family: var(--font-mono);" id="modalSaldoPrevisto">R$ 29,92</span>
          </div>
        </div>

        <form id="formExecutarConsulta" onsubmit="return false;">
          <input type="hidden" id="inputModalModuloId" value="" />

          <div style="margin-bottom: var(--space-4);">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
              <label for="inputParametroValor" style="font-size: 0.85rem; font-weight: 600; color: var(--color-text);" id="labelParametroNome">
                Número do CPF
              </label>
              <button type="button" id="btnUsarExemploTeste" style="background: none; border: none; color: #8B5CF6; font-size: 0.75rem; font-weight: 600; cursor: pointer; text-decoration: underline;">
                Preencher Amostra Válida
              </button>
            </div>
            <input
              type="text"
              id="inputParametroValor"
              class="hub-search-input"
              style="padding-left: 14px; font-family: var(--font-mono); font-size: 1rem;"
              placeholder="000.000.000-00"
              autocomplete="off"
              required
            />
          </div>

          <!-- Controle de Cache Inteligente Multi-Tier -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-4); font-size: 0.78rem; background: var(--color-surface-2); padding: 8px 12px; border-radius: var(--radius-sm); border: 1px solid var(--color-border);">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--color-text); font-weight: 500;">
              <input type="checkbox" id="checkUsarCache" checked style="accent-color: #10B981; width: 15px; height: 15px; cursor: pointer;">
              <span>Usar Cache Inteligente (Economiza saldo e tempo de resposta)</span>
            </label>
            <span style="color: #10B981; font-family: var(--font-mono); font-size: 0.72rem; display: flex; align-items: center; gap: 4px;">
              <i data-lucide="zap" style="width: 12px; height: 12px;"></i>
              Instantâneo
            </span>
          </div>

          <!-- Área de Feedback / Loading -->
          <div id="hubExecucaoLoading" style="display: none; padding: 16px; text-align: center; background: rgba(139, 92, 246, 0.08); border: 1px dashed rgba(139, 92, 246, 0.3); border-radius: var(--radius-md); margin-bottom: var(--space-4);">
            <div style="display: inline-flex; align-items: center; gap: 8px; color: #8B5CF6; font-size: 0.9rem; font-weight: 600;">
              <i data-lucide="loader-2" class="spin-icon" style="width: 18px; height: 18px;"></i>
              <span id="hubLoadingText">Consultando bases externas e decodificando telemetria...</span>
            </div>
            <p style="font-size: 0.75rem; color: var(--color-text-muted); margin-top: 6px; margin-bottom: 0;">
              Bases públicas e operadoras podem levar de 10s a 30s. A consulta está em andamento seguro sem interrupção.
            </p>
          </div>

          <!-- Mensagem de Erro -->
          <div id="hubExecucaoErro" style="display: none; padding: 12px; background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-md); color: #EF4444; font-size: 0.85rem; margin-bottom: var(--space-4);">
          </div>

          <!-- Área de Resultados Estruturados -->
          <div id="hubResultadoArea" style="display: none; margin-top: var(--space-4);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
              <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <span style="font-size: 0.85rem; font-weight: 700; color: #10B981; display: flex; align-items: center; gap: 6px;">
                  <i data-lucide="check-circle" style="width: 16px; height: 16px;"></i>
                  Resposta Recebida
                </span>
                <span id="hubCacheBadge" style="display: none; font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; background: rgba(16, 185, 129, 0.15); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.3); font-weight: 700;">
                  ⚡ Cache Instantâneo (R$ 0,00)
                </span>
              </div>
              <div style="display: flex; gap: 6px;">
                <button type="button" class="btn btn-outline btn-sm" id="btnForcarRecarregarAoVivo" style="display: none; font-size: 0.75rem; padding: 3px 8px; color: #F59E0B; border-color: rgba(245, 158, 11, 0.3);">
                  <i data-lucide="refresh-cw" style="width: 12px; height: 12px;"></i>
                  <span>Atualizar Ao Vivo</span>
                </button>
                <button type="button" class="btn btn-outline btn-sm" id="btnCopiarJsonResultado">
                  <i data-lucide="copy" style="width: 13px; height: 13px;"></i>
                  <span>Copiar JSON</span>
                </button>
              </div>
            </div>
            <pre class="hub-json-pre" id="jsonResultadoPre"></pre>
          </div>
        </form>
      </div>

      <div class="hub-modal-footer">
        <button type="button" class="btn btn-outline" id="btnCancelarConsulta">Fechar</button>
        <button type="button" class="btn btn-primary" id="btnConfirmarConsulta" style="background: #8B5CF6; border-color: #7C3AED;">
          <i data-lucide="zap" style="width: 16px; height: 16px;"></i>
          <span id="btnConfirmarTexto">Executar Consulta</span>
        </button>
      </div>
    </div>
  </div>

