<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || '403 - Acesso Negado | RimuBusca' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <style>
    .error-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
      background-color: var(--color-bg);
      text-align: center;
    }
    .error-card {
      max-width: 500px;
      padding: var(--space-8);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }
    .error-code {
      font-family: var(--font-mono);
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--color-error);
      line-height: 1;
      margin-bottom: var(--space-2);
    }
    .error-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
    }
    .error-msg {
      margin-bottom: var(--space-6);
      font-size: 0.9375rem;
    }
    .btn-group {
      display: flex;
      justify-content: center;
      gap: var(--space-3);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 10px 20px;
      border-radius: var(--radius-md);
      font-weight: 600;
      text-decoration: none;
      font-size: 0.875rem;
      transition: all var(--transition-fast);
    }
    .btn-primary {
      background: var(--color-primary);
      color: #0A0E1A;
    }
    .btn-primary:hover {
      background: var(--color-primary-hover);
    }
    .btn-outline {
      background: var(--color-surface-2);
      color: var(--color-text);
      border: 1px solid var(--color-border);
    }
    .btn-outline:hover {
      background: var(--color-surface-3);
    }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-card">
      <div class="error-code">403</div>
      <h1 class="error-title">Acesso Restrito ao Painel Admin</h1>
      <p class="error-msg"><%= mensagem || 'Seu perfil de usuário não possui as permissões necessárias para gerenciar esta seção.' %></p>
      <div class="btn-group">
        <a href="/dashboard" class="btn btn-primary">
          <i data-lucide="layout-dashboard" style="width: 16px; height: 16px;"></i>
          <span>Voltar ao Dashboard</span>
        </a>
        <a href="/auth/logout" class="btn btn-outline">
          <i data-lucide="log-out" style="width: 16px; height: 16px;"></i>
          <span>Trocar de Conta</span>
        </a>
      </div>
    </div>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>

