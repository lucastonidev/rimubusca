<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 - Erro no Servidor | RimuBusca</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <style>
    .error-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--space-4);
      background-color: var(--color-bg);
      text-align: center;
    }
    .error-card {
      max-width: 600px;
      padding: var(--space-8);
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
    }
    .error-code {
      font-family: var(--font-mono);
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--color-error);
      line-height: 1;
      margin-bottom: var(--space-2);
    }
    .error-title {
      font-size: 1.25rem;
      margin-bottom: var(--space-3);
    }
    .error-msg {
      margin-bottom: var(--space-4);
      font-size: 0.9375rem;
    }
    .stack-trace {
      text-align: left;
      background-color: var(--color-bg);
      padding: var(--space-4);
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #F87171;
      overflow-x: auto;
      max-height: 200px;
      margin-bottom: var(--space-6);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: 10px 20px;
      background: var(--color-primary);
      color: #0A0E1A;
      font-weight: 600;
      border-radius: var(--radius-md);
      text-decoration: none;
      transition: all var(--transition-fast);
    }
    .btn:hover {
      background: var(--color-primary-hover);
    }
  </style>
</head>
<body>
  <div class="error-container">
    <div class="error-card">
      <div class="error-code">500</div>
      <h1 class="error-title">Falha Interna de Processamento</h1>
      <p class="error-msg"><%= mensagem || 'Ocorreu um erro inesperado na execução da solicitação.' %></p>
      
      <% if (typeof stack !== 'undefined' && stack) { %>
        <pre class="stack-trace"><code><%= stack %></code></pre>
      <% } %>

      <a href="/dashboard" class="btn">
        <i data-lucide="refresh-cw" style="width: 18px; height: 18px;"></i>
        <span>Recarregar Início</span>
      </a>
    </div>
  </div>
  <script>lucide.createIcons();</script>
</body>
</html>

