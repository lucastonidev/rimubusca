<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('../partials/head') %>
  <style>
    .logs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.85rem;
    }

    .logs-table th {
      background: var(--color-surface-2);
      padding: var(--space-3) var(--space-4);
      text-align: left;
      font-weight: 600;
      color: var(--color-text-dim);
      border-bottom: 1px solid var(--color-border);
      text-transform: uppercase;
      font-size: 0.72rem;
      letter-spacing: 0.05em;
    }

    .logs-table td {
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text);
      vertical-align: middle;
    }

    .logs-table tr:hover td {
      background: rgba(139, 92, 246, 0.03);
    }

    .filter-bar {
      display: flex;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
      flex-wrap: wrap;
      align-items: center;
    }
  </style>
</head>
<body>
  <div class="app-layout">
    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <%- include('../partials/sidebar') %>

    <div class="app-main">
      <%- include('../partials/header') %>

      <main class="app-content">
        <!-- Topo da Auditoria -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-5); flex-wrap: wrap; gap: var(--space-4);">
          <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
              <span class="badge badge-purple">Segurança & Conformidade</span>
              <span class="badge badge-red">Trilha Imutável</span>
            </div>
            <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-text); margin: 0;">
              Registros de Auditoria & Acessos
            </h1>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin-top: 4px;">
              Histórico rastreável e não-repudiável de todas as consultas, logins e alterações administrativas realizadas no sistema.
            </p>
          </div>

          <div style="display: flex; gap: var(--space-2);">
            <button type="button" class="btn btn-secondary btn-sm" id="btnExportarJson">
              <i data-lucide="download" style="width: 14px; height: 14px;"></i>
              Exportar JSON
            </button>
          </div>
        </div>

        <!-- Filtros de Busca -->
        <form method="GET" action="/admin/logs" class="filter-bar">
          <div style="flex: 1; min-width: 200px;">
            <input
              type="text"
              name="acao"
              class="input"
              placeholder="Filtrar por ação (ex: busca_telefone, login, cpf)..."
              value="<%= acaoFiltro || '' %>"
              style="padding: 8px 12px; font-size: 0.85rem;"
            />
          </div>

          <button type="submit" class="btn btn-primary btn-sm">
            <i data-lucide="filter" style="width: 14px; height: 14px;"></i>
            Filtrar
          </button>

          <% if (acaoFiltro) { %>
            <a href="/admin/logs" class="btn btn-secondary btn-sm">Limpar</a>
          <% } %>
        </form>

        <!-- Tabela de Logs de Auditoria -->
        <div class="card" style="padding: 0; overflow-x: auto;">
          <table class="logs-table">
            <thead>
              <tr>
                <th>Data & Hora</th>
                <th>Ação</th>
                <th>Operador</th>
                <th>Origem (IP)</th>
                <th style="text-align: right;">Detalhes</th>
              </tr>
            </thead>
            <tbody>
              <% if (logs && logs.length > 0) { %>
                <% logs.forEach(log => { %>
                  <tr>
                    <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim); white-space: nowrap;">
                      <%= new Date(log.criado_em).toLocaleString('pt-BR') %>
                    </td>
                    <td>
                      <span class="badge <%= log.acao.includes('admin') ? 'badge-red' : log.acao.includes('busca') ? 'badge-purple' : 'badge-dark' %>" style="font-family: var(--font-mono); font-size: 0.72rem;">
                        <%= log.acao %>
                      </span>
                    </td>
                    <td>
                      <div style="font-weight: 600; color: var(--color-text); font-size: 0.85rem;">
                        <%= log.profiles?.nome || 'Operador Anônimo' %>
                      </div>
                      <div style="font-size: 0.75rem; color: var(--color-text-dim); font-family: var(--font-mono);">
                        <%= log.profiles?.email || 'N/A' %>
                      </div>
                    </td>
                    <td style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim);">
                      <%= log.ip || '0.0.0.0' %>
                    </td>
                    <td style="text-align: right;">
                      <button
                        type="button"
                        class="btn btn-secondary btn-sm btn-ver-detalhes"
                        data-detalhes="<%= encodeURIComponent(JSON.stringify(log.detalhes || {})) %>"
                        data-acao="<%= log.acao %>"
                        style="padding: 4px 8px; font-size: 0.75rem;"
                      >
                        <i data-lucide="eye" style="width: 12px; height: 12px;"></i>
                        Inspecionar
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" style="text-align: center; padding: var(--space-6); color: var(--color-text-dim);">
                    Nenhum registro de auditoria encontrado para o filtro aplicado.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </main>

      <%- include('../partials/footer') %>
    </div>
  </div>

  <%- include('../partials/bottom-nav') %>
  <%- include('../partials/command-palette') %>
  <%- include('../partials/toast') %>

  <!-- Modal Detalhes do Log -->
  <div id="modalDetalhesLog" class="modal-backdrop" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); z-index: var(--z-modal); align-items: center; justify-content: center; padding: var(--space-4);">
    <div style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); width: 100%; max-width: 600px; max-height: 80vh; display: flex; flex-direction: column; overflow: hidden;">
      <div style="padding: var(--space-4); border-bottom: 1px solid var(--color-border); display: flex; justify-content: space-between; align-items: center;">
        <span style="font-weight: 700; color: var(--color-text);" id="modalLogTitulo">Detalhes do Evento</span>
        <button type="button" onclick="document.getElementById('modalDetalhesLog').style.display='none'" style="background: none; border: none; color: var(--color-text-muted); cursor: pointer;">
          <i data-lucide="x" style="width: 18px; height: 18px;"></i>
        </button>
      </div>
      <pre id="preDetalhesLog" style="padding: var(--space-4); margin: 0; overflow-y: auto; font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-text-dim); background: var(--color-surface-2); flex: 1;"></pre>
      <div style="padding: var(--space-3); border-top: 1px solid var(--color-border); display: flex; justify-content: flex-end;">
        <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('modalDetalhesLog').style.display='none'">Fechar</button>
      </div>
    </div>
  </div>

  <script src="/js/api.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/main.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const modal = document.getElementById('modalDetalhesLog');
      const titulo = document.getElementById('modalLogTitulo');
      const pre = document.getElementById('preDetalhesLog');

      document.querySelectorAll('.btn-ver-detalhes').forEach(btn => {
        btn.addEventListener('click', () => {
          const raw = decodeURIComponent(btn.dataset.detalhes || '{}');
          try {
            const parsed = JSON.parse(raw);
            pre.textContent = JSON.stringify(parsed, null, 2);
          } catch {
            pre.textContent = raw;
          }
          titulo.textContent = `Payload da Ação: ${btn.dataset.acao}`;
          modal.style.display = 'flex';
        });
      });

      // Exportar logs da tela como JSON
      document.getElementById('btnExportarJson')?.addEventListener('click', () => {
        const rows = [];
        document.querySelectorAll('.btn-ver-detalhes').forEach(btn => {
          try {
            rows.push({
              acao: btn.dataset.acao,
              detalhes: JSON.parse(decodeURIComponent(btn.dataset.detalhes || '{}'))
            });
          } catch {}
        });

        const blob = new Blob([JSON.stringify(rows, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `rimubusca_auditoria_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        window.toast?.success('Relatório de auditoria exportado!');
      });
    });
  </script>
</body>
</html>

