<aside class="app-sidebar" id="appSidebar">
  <!-- Cabeçalho da Sidebar: Marca do Sistema -->
  <div class="sidebar-header">
    <a href="/dashboard" class="sidebar-brand" title="RimuBusca - Início">
      <div class="sidebar-brand-icon">
        <img src="/images/logo.jpeg" alt="Logo" class="sidebar-logo">  
      </div>
      <div class="sidebar-brand-text">
        Rimu<span>Busca</span>
      </div>
    </a>
  </div>

  <!-- Navegação Principal Enxuta para Usuários -->
  <div class="sidebar-content">
    <div class="nav-section nav-section-top">
      <!-- Início / Dashboard -->
      <a href="/dashboard" class="nav-item <%= typeof currentPath !== 'undefined' && (currentPath === '/dashboard' || currentPath === '/') ? 'active' : '' %>" title="Início / Dashboard">
        <span class="nav-item-icon"><i data-lucide="layout-dashboard"></i></span>
        <span class="nav-item-text">Início</span>
      </a>

      <!-- Histórico de Consultas -->
      <a href="/history" class="nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/history' ? 'active' : '' %>" title="Histórico de Consultas">
        <span class="nav-item-icon"><i data-lucide="history"></i></span>
        <span class="nav-item-text">Histórico</span>
      </a>

      <!-- Catálogo de APIs Pay-per-Use (Hub de APIs) -->
      <a href="/hub-api" class="nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/hub-api' ? 'active' : '' %>" title="Catálogo de APIs Pay-per-Use">
        <span class="nav-item-icon"><i data-lucide="coins" style="color: #F59E0B;"></i></span>
        <span class="nav-item-text">Hub Pay-per-Use</span>
        <span class="nav-badge badge-warning" style="font-size: 0.68rem; padding: 2px 6px; font-weight: 700;">R$ 30</span>
      </a>

      <!-- Acesso rápido ao Painel Admin (visível apenas para administradores) -->
      <% if ((typeof isAdmin !== 'undefined' && isAdmin) || (typeof user !== 'undefined' && user?.profile?.role === 'admin')) { %>
        <div style="margin: 12px 0 6px 0; border-top: 1px solid var(--color-border); padding-top: 10px;">
          <div class="nav-section-title" style="font-size: 0.65rem; color: #EF4444; display: flex; align-items: center; gap: 4px; padding: 0 10px; margin-bottom: 6px;">
            <i data-lucide="shield" style="width: 11px; height: 11px;"></i> ESPAÇO ADMIN
          </div>
          <a href="/admin" class="nav-item nav-item-admin-entry" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.2); color: #F87171;" title="Entrar no Painel Administrativo">
            <span class="nav-item-icon"><i data-lucide="shield-alert" style="color: #EF4444;"></i></span>
            <span class="nav-item-text" style="font-weight: 600;">Painel Admin</span>
            <span class="nav-badge" style="background: rgba(239, 68, 68, 0.2); color: #EF4444; border-radius: 4px; padding: 2px 5px; font-weight: 700; font-size: 0.65rem;">ENTRAR</span>
          </a>
        </div>
      <% } %>
    </div>

    <!-- Grupo Inferior: Configurações, Ajuda e Sair -->
    <div class="nav-section nav-section-bottom">
      <a href="/configuracoes" class="nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/configuracoes' ? 'active' : '' %>" title="Configurações">
        <span class="nav-item-icon"><i data-lucide="settings"></i></span>
        <span class="nav-item-text">Configurações</span>
      </a>

      <a href="/ajuda" class="nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/ajuda' ? 'active' : '' %>" title="Ajuda & Guia">
        <span class="nav-item-icon"><i data-lucide="help-circle"></i></span>
        <span class="nav-item-text">Ajuda</span>
      </a>

      <a href="/auth/logout" class="nav-item" style="color: var(--color-secondary);" title="Sair da Conta">
        <span class="nav-item-icon"><i data-lucide="log-out"></i></span>
        <span class="nav-item-text">Sair</span>
      </a>
    </div>
  </div>

  <!-- Rodapé com Perfil do Operador -->
  <a href="/configuracoes" class="sidebar-footer" title="Perfil do Usuário">
    <div class="user-avatar">
      <%= typeof user !== 'undefined' && user?.profile?.nome ? user.profile.nome.charAt(0).toUpperCase() : (typeof user !== 'undefined' && user?.email ? user.email.charAt(0).toUpperCase() : 'O') %>
    </div>
    <div class="user-profile-info">
      <div class="user-profile-name">
        <%= typeof user !== 'undefined' && user?.profile?.nome ? user.profile.nome : (typeof user !== 'undefined' && user?.email ? user.email.split('@')[0] : 'Operador') %>
      </div>
      <div class="user-profile-role">
        <%= typeof user !== 'undefined' && user?.profile?.role ? user.profile.role.toUpperCase() : 'OPERADOR' %>
      </div>
    </div>
  </a>
</aside>

