# ==============================================================================
# RIMUBUSCA - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env.example)
# Plataforma de Inteligência e Investigação OSINT (Open Source Intelligence)
# Copie este arquivo para .env e preencha com suas respectivas credenciais.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR & SEGURANÇA
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Chave secreta interna para assinatura de cookies e proteções criptográficas
# Requisito: String randômica com no mínimo 32 caracteres (ex: openssl rand -hex 32)
SESSION_SECRET=sua_chave_secreta_super_segura_com_minimo_32_caracteres_rimubusca

# Chave para criptografia de API keys na tabela api_keys (pgcrypto)
PGCRYPTO_ENCRYPTION_KEY=chave_mestra_para_criptografia_de_api_keys_32chars

# ------------------------------------------------------------------------------
# 2. SUPABASE (AUTENTICAÇÃO, BANCO DE DADOS & POLÍTICAS RLS)
# Obtenha no painel: https://app.supabase.com/project/_/settings/api
# ------------------------------------------------------------------------------
# URL base do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Anônima Pública (Safe para queries públicas respeitando RLS)
SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui

# Chave Service Role (Privada do backend - NUNCA expor no front-end)
SUPABASE_SERVICE_ROLE_KEY=sua_supabase_service_role_key_aqui

# ------------------------------------------------------------------------------
# 3. MOTORES OSINT & SERVIÇOS TÉCNICOS
# ------------------------------------------------------------------------------
# Modo de simulação: true = retorna mocks estruturados | false = conecta em APIs reais
MOCK_MODE=true

# 3.1. Telefone & Telecom (Carrier Lookup / Operadora / Portabilidade)
CARRIER_LOOKUP_API_URL=https://carrier-lookup-api.omkar.cloud/lookup
CARRIER_LOOKUP_API_KEY=sua_chave_carrier_lookup_aqui

# 3.2. E-mail, Domínio & Reputação Técnica (Hunter.io / HaveIBeenPwned / WhoisXML)
HUNTER_API_KEY=sua_chave_hunter_io_opcional
HIBP_API_KEY=sua_chave_haveibeenpwned_opcional
WHOISXML_API_KEY=sua_chave_whoisxml_aqui

# 3.3. Redes Sociais & Coleta Profunda
# Sessão opcional para consultas de correlação e recuperação pública do Instagram
INSTAGRAM_SESSION_ID=sua_session_id_instagram_opcional

# Bright Data Web Scraper (Opcional - Coleta social profunda e posts públicos)
BRIGHTDATA_API_KEY=sua_chave_brightdata_opcional
BRIGHTDATA_SERP_ZONE=

# 3.4. Processos Judiciais (DataJud CNJ / BuscaProcessos API)
BUSCAPROCESSOS_API_URL=https://api.buscaprocessos.app.br/v1
BUSCAPROCESSOS_API_KEY=sua_chave_buscaprocessos_aqui

# 3.5. Transparência Pública & Compliance Federal (Gov.br / CGU)
# Cadastro gratuito em: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=sua_chave_portal_transparencia_aqui

# 3.6. Surface Web OSINT / Blockchain (Opcional)
SERPAPI_KEY=sua_chave_serpapi_opcional

# ------------------------------------------------------------------------------
# 4. RIMUAPI / SANT BUSCAS API ENGINE (43 MÓDULOS DE INTELIGÊNCIA)
# ------------------------------------------------------------------------------
# Endpoint base do motor de consultas (ex: https://sua-api.vercel.app ou http://localhost:3001)
RIMUAPI_URL=https://sua-api.vercel.app
# Chave de API secreta enviada via cabeçalho 'x-api-key'
RIMUAPI_KEY=sua_chave_de_api_aqui
# Autenticação básica HTTP para conexões remotas na Vercel (Padrão: admin / vazio)
RIMUAPI_BASIC_USER=admin
RIMUAPI_BASIC_PASS=
